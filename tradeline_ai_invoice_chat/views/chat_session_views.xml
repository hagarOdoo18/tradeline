<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Action: open the full-page chat client
    ============================================================ -->
    <record id="action_ai_invoice_chat" model="ir.actions.client">
        <field name="name">Tradeline AI Assistant</field>
        <field name="tag">ai_invoice_chat</field>
    </record>

    <!-- Back-office list view for sessions (admin) -->
    <record id="view_ai_chat_session_list" model="ir.ui.view">
        <field name="name">ai.chat.session.list</field>
        <field name="model">ai.chat.session</field>
        <field name="arch" type="xml">
            <list string="Chat Sessions" decoration-muted="not active">
                <field name="name"/>
                <field name="user_id"/>
                <field name="message_count"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="action_ai_chat_sessions_list" model="ir.actions.act_window">
        <field name="name">Chat Sessions</field>
        <field name="res_model">ai.chat.session</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
