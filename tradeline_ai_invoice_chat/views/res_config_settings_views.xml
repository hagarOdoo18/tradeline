<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 17/18 settings DSL: <app> / <block> / <setting>.
         The parent MUST be base_setup.res_config_settings_view_form (a view);
         base_setup.action_general_configuration is an action, not a view. -->
    <record id="res_config_settings_view_ai_chat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tradeline.ai</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Tradeline AI Assistant"
                     data-string="Tradeline AI Assistant"
                     name="tradeline_ai_invoice_chat">





                    <block title="AI Provider" name="tradeline_ai_provider">
                        <setting string="API Key"
                                 help="Secret key of an OpenAI-compatible provider (sk-...). Without it the assistant falls back to Odoo IAP, then to raw pinned reports.">
                            <field name="ai_invoice_chat_openai_key"
                                   password="True"
                                   placeholder="sk-..."/>
                        </setting>
                        <setting string="Model"
                                 help="Must support tool calling, e.g. gpt-4o-mini or gpt-4o.">
                            <field name="ai_invoice_chat_openai_model"
                                   placeholder="gpt-4o-mini"/>
                        </setting>
                        <setting string="API Base URL"
                                 help="Change it to use Azure OpenAI, DeepSeek, Groq or a local gateway.">
                            <field name="ai_invoice_chat_base_url"
                                   placeholder="https://api.openai.com/v1"/>
                        </setting>
                    </block>

                    <block title="Data Scope" name="tradeline_ai_scope">
                        <setting string="Allow Any Model"
                                 help="Let the assistant reach every model, not only the curated business catalog. Technical and credential models stay blocked, and each user only ever sees what their own access rights allow.">
                            <field name="ai_invoice_chat_allow_all_models"/>
                        </setting>
                        <setting string="Max Rows per Query"
                                 help="Row/group ceiling for a single query (hard maximum: 500).">
                            <field name="ai_invoice_chat_max_rows"/>
                        </setting>
                        <setting string="Additional Models"
                                 help="Comma-separated technical model names to add to the catalog.">
                            <field name="ai_invoice_chat_extra_models"
                                   placeholder="mrp.production, fleet.vehicle"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

</odoo>
