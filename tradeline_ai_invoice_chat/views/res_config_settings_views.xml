<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_ai_chat" model="ir.ui.view">
        <field name="name">res.config.settings.view.tradeline.ai.assistant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_settings_container')]" position="inside">
                <div class="app_settings_block"
                     data-string="Tradeline AI Assistant"
                     string="Tradeline AI Assistant"
                     data-key="tradeline_ai_invoice_chat">
                    <h2>AI Provider</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">API Key</span>
                                <div class="text-muted">
                                    Key of an OpenAI-compatible provider (sk-...).
                                    Without it the assistant only returns raw pinned reports.
                                </div>
                                <div class="content-group mt8">
                                    <field name="ai_invoice_chat_openai_key"
                                           password="True"
                                           placeholder="sk-..."/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Model</span>
                                <div class="text-muted">
                                    Must support tool calling, e.g. gpt-4o-mini or gpt-4o.
                                </div>
                                <div class="content-group mt8">
                                    <field name="ai_invoice_chat_openai_model"
                                           placeholder="gpt-4o-mini"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">API Base URL</span>
                                <div class="text-muted">
                                    Change to use Azure OpenAI, DeepSeek, Groq or a local gateway.
                                </div>
                                <div class="content-group mt8">
                                    <field name="ai_invoice_chat_base_url"
                                           placeholder="https://api.openai.com/v1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2>Data Scope</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="ai_invoice_chat_allow_all_models"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ai_invoice_chat_allow_all_models"/>
                                <div class="text-muted">
                                    Let the assistant reach every model, not only the curated
                                    business catalog. Technical and credential models stay
                                    blocked, and each user only ever sees what their own
                                    access rights allow.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Max Rows per Query</span>
                                <div class="text-muted">
                                    Row/group ceiling for one query (max 500).
                                </div>
                                <div class="content-group mt8">
                                    <field name="ai_invoice_chat_max_rows"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Additional Models</span>
                                <div class="text-muted">
                                    Comma-separated technical names to add to the catalog.
                                </div>
                                <div class="content-group mt8">
                                    <field name="ai_invoice_chat_extra_models"
                                           placeholder="mrp.production, fleet.vehicle"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
