<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_business_customer_only" model="ir.ui.view">
        <field name="name">product.template.form.business.customer.only</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_ok']" position="after">
                <field name="business_customer_only"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_business_customer_only" model="ir.ui.view">
        <field name="name">product.template.list.business.customer.only</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="business_customer_only" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
