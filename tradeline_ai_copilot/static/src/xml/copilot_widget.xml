<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tradeline_ai_copilot.Chart">
        <section class="tl-ai-chart" t-att-aria-label="props.block.title">
            <h3><t t-esc="props.block.title"/></h3>
            <div class="tl-ai-chart-canvas"><canvas t-ref="canvas" role="img" t-att-aria-label="props.block.title + '. Exact values are in the accompanying data table.'"/></div>
            <p t-if="props.block.truncated" class="tl-ai-muted">Chart shows a limited set of groups. See the table for the returned data.</p>
        </section>
    </t>
    <t t-name="tradeline_ai_copilot.PanelContent">
        <aside t-if="state.sidebar" class="tl-ai-sidebar" aria-label="Conversations">
            <button type="button" class="tl-ai-icon-button tl-ai-sidebar-dismiss" t-on-click="toggleSidebar" aria-label="Close conversations"><i class="fa fa-times" aria-hidden="true"/></button>
            <div class="tl-ai-sidebar-brand"><img src="/tradeline_ai_copilot/static/src/img/tradeline_ai_wordmark.svg" alt="Tradeline AI" width="202" height="48"/></div>
            <button type="button" class="tl-ai-button tl-ai-primary tl-ai-new" t-on-click="newConversation" t-att-disabled="busy"><i class="fa fa-plus" aria-hidden="true"/> New conversation</button>
            <div t-if="state.enableHistory" class="tl-ai-search"><i class="fa fa-search" aria-hidden="true"/><input type="search" aria-label="Search conversations" placeholder="Search conversations..." t-att-value="state.search" t-on-input="onSearch"/></div>
            <div class="tl-ai-recent">Recent</div>
            <nav class="tl-ai-history">
                <button type="button" t-foreach="filteredHistory" t-as="item" t-key="item.id" t-att-class="'tl-ai-history-item ' + (item.id === state.conversationId ? 'is-selected' : '')" t-att-aria-current="item.id === state.conversationId ? 'page' : undefined" t-att-title="item.name" t-on-click="() => this.loadConversation(item.id)" t-att-disabled="busy"><t t-esc="item.name"/></button>
                <p t-if="!filteredHistory.length" class="tl-ai-muted">Your conversations will appear here.</p>
            </nav>
            <div class="tl-ai-sidebar-footer"><i class="fa fa-lock" aria-hidden="true"/> Your Odoo permissions apply.</div>
        </aside>
        <main class="tl-ai-main">
            <header class="tl-ai-topbar">
                <button type="button" class="tl-ai-icon-button" t-on-click="toggleSidebar" title="Toggle conversations" aria-label="Toggle conversations" t-att-aria-expanded="state.sidebar ? 'true' : 'false'"><i class="fa fa-bars" aria-hidden="true"/></button>
                <div class="tl-ai-heading"><h1>Chat with Odoo</h1><p>Your executive workspace</p></div>
                <label class="tl-ai-provider"><span class="tl-ai-sr-only">AI provider</span><select aria-label="AI provider" t-att-value="state.provider" t-on-change="onProviderChange" t-att-disabled="busy"><option value="claude">Claude</option><option value="openai">OpenAI</option></select></label>
                <button type="button" t-if="!embedded" class="tl-ai-icon-button" t-on-click="toggleSize" title="Resize chat" aria-label="Resize chat"><i class="fa fa-expand" aria-hidden="true"/></button>
                <button type="button" t-if="!embedded" class="tl-ai-icon-button" t-on-click="toggleOpen" title="Close chat" aria-label="Close chat"><i class="fa fa-times" aria-hidden="true"/></button>
            </header>
            <div class="tl-ai-messages" t-ref="messages" t-on-scroll="onMessagesScroll" role="log" aria-label="Chat messages" t-att-aria-live="state.loading ? 'off' : 'polite'" t-att-aria-busy="busy ? 'true' : 'false'">
                <div class="tl-ai-message-column">
                    <section t-if="!state.messages.length" class="tl-ai-empty">
                        <div class="tl-ai-empty-icon"><i class="fa fa-comments-o" aria-hidden="true"/></div>
                        <h2>What would you like to know?</h2><p>Ask in plain English about the saved data you can access.<br/>Get an explanation, a chart and the sources behind it.</p>
                        <div class="tl-ai-suggestions"><button type="button" t-foreach="suggestions" t-as="suggestion" t-key="suggestion" class="tl-ai-suggestion" t-on-click="() => this.useSuggestion(suggestion)" t-att-disabled="busy"><span><t t-esc="suggestion"/></span><i class="fa fa-arrow-up" aria-hidden="true"/></button></div>
                    </section>
                    <article t-foreach="state.messages" t-as="msg" t-key="msg.id || msg_index" t-att-class="'tl-ai-message ' + (msg.role === 'user' ? 'is-user' : 'is-assistant')">
                        <t t-if="msg.role === 'user'"><div class="tl-ai-user-bubble" dir="auto"><t t-esc="msg.content"/></div></t>
                        <t t-elif="msg.role === 'assistant'">
                            <div class="tl-ai-assistant-label"><img src="/tradeline_ai_copilot/static/src/img/tradeline_ai_mark.svg" alt="" width="22" height="22"/><span>Your reporting coworker</span></div>
                            <t t-foreach="msg.blocks || []" t-as="block" t-key="block_index">
                                <div t-if="block.type === 'text'" class="tl-ai-answer" dir="auto"><t t-foreach="answerParts(block.content, msg)" t-as="part" t-key="part_index"><a t-if="part.url" t-att-href="part.url" t-att-title="part.title" target="_blank" rel="noopener noreferrer"><t t-esc="part.text"/></a><t t-else="" t-esc="part.text"/></t><span t-if="msg.streaming" class="tl-ai-stream-cursor" aria-hidden="true">▍</span></div>
                                <section t-elif="block.type === 'web_sources'" class="tl-ai-result tl-ai-source"><h3>Public web sources</h3><p><t t-esc="block.subject"/> · <t t-esc="block.queried_at"/> UTC</p><ul><li t-foreach="block.citations" t-as="citation" t-key="citation.id"><a t-att-href="citation.url" target="_blank" rel="noopener noreferrer">[<t t-esc="citation.id"/>] <t t-esc="citation.title"/></a></li></ul><p><t t-esc="block.scope"/></p></section>
                                <div t-elif="block.type === 'reply_choices'" class="tl-ai-reply-choices" aria-label="Suggested replies"><button type="button" t-foreach="block.choices" t-as="choice" t-key="choice_index" class="tl-ai-button" t-on-click="() => this.useReplyChoice(choice)" t-att-disabled="busy"><t t-esc="choice"/></button><span class="tl-ai-muted">Choose a starting point, then edit your reply.</span></div>
                                <div t-elif="block.type === 'warning' || block.type === 'clarification'" class="tl-ai-warning" role="status"><i class="fa fa-info-circle" aria-hidden="true"/><span dir="auto"><t t-esc="block.content"/></span></div>
                                <CopilotChart t-elif="block.type === 'chart'" block="block"/>
                                <section t-elif="block.type === 'table'" class="tl-ai-result">
                                    <div class="tl-ai-result-heading"><h3><t t-esc="block.title || 'Supporting data'"/></h3><span><t t-esc="block.rows.length"/> rows<t t-if="block.truncated"> · limited</t></span></div>
                                    <CopilotChart t-if="block.chart" block="block.chart"/>
                                    <details class="tl-ai-evidence" t-att-open="block.rows.length &lt;= 12 ? true : undefined"><summary>Supporting data · <t t-esc="block.rows.length"/> rows</summary><div class="tl-ai-table-scroll" tabindex="0" role="region" aria-label="Result data"><table><thead><tr><th t-foreach="block.columns" t-as="column" t-key="column" scope="col"><t t-esc="block.labels ? (block.labels[column] || column) : column"/></th></tr></thead><tbody><tr t-foreach="block.rows" t-as="row" t-key="row_index"><td t-foreach="block.columns" t-as="column" t-key="column" dir="auto"><t t-esc="normalizeValue(row[column])"/></td></tr><tr t-if="!block.rows.length"><td t-att-colspan="block.columns.length">No records match these filters.</td></tr></tbody></table></div></details>
                                    <details t-if="block.provenance" class="tl-ai-source">
                                        <summary><i class="fa fa-database" aria-hidden="true"/> Sources &amp; filters <span>[<t t-esc="block.provenance.source_id"/>] · <t t-esc="block.provenance.model_label"/></span></summary>
                                        <dl>
                                            <dt>Source</dt><dd><t t-esc="block.provenance.model_label"/> (<t t-esc="block.provenance.model"/>)</dd>
                                            <dt>Queried at</dt><dd><t t-esc="block.provenance.queried_at"/> UTC · <t t-esc="block.provenance.source_kind === 'live_shopify' ? 'live Shopify API' : 'saved Odoo data'"/></dd>
                                            <dt t-if="block.provenance.metric_definition">Definition</dt><dd t-if="block.provenance.metric_definition"><t t-esc="block.provenance.metric_definition.definition"/></dd>
                                            <dt t-if="block.provenance.freshness">Freshness</dt><dd t-if="block.provenance.freshness"><t t-if="block.provenance.freshness.latest_visible_change_utc">Latest visible saved change: <t t-esc="block.provenance.freshness.latest_visible_change_utc"/> UTC. </t><t t-if="block.provenance.freshness.read_completed_utc">Live read completed: <t t-esc="block.provenance.freshness.read_completed_utc"/> UTC. </t><t t-esc="block.provenance.freshness.note"/></dd>
                                            <dt>Companies</dt><dd><t t-esc="sourceCompanies(block.provenance)"/></dd>
                                            <dt>Measures / fields</dt><dd><t t-esc="sourceFields(block.provenance, block.provenance.fields)"/></dd>
                                            <dt t-if="block.provenance.group_by.length">Grouped by</dt><dd t-if="block.provenance.group_by.length"><t t-esc="sourceFields(block.provenance, block.provenance.group_by)"/></dd>
                                            <dt>Filters</dt><dd><ul t-if="block.provenance.filters.length"><li t-foreach="block.provenance.filters" t-as="filter" t-key="filter_index"><t t-esc="sourceFilter(filter)"/></li></ul><t t-else="">No additional filters.</t></dd>
                                            <dt>Coverage</dt><dd><t t-esc="block.provenance.returned_rows"/> rows/groups returned · limit <t t-esc="block.provenance.limit"/><t t-if="block.provenance.truncated"> · additional results omitted</t><t t-if="block.provenance.active_test"> · archived records excluded where applicable</t></dd>
                                        </dl>
                                        <p><t t-esc="block.provenance.scope"/> The explanation is AI generated; check it against this data.</p>
                                    </details>
                                    <div class="tl-ai-result-actions" t-if="block.query_meta and block.can_export">
                                        <button type="button" t-if="state.enableXlsx" class="tl-ai-button" t-on-click="() => this.exportResult(block, 'xlsx')" t-att-disabled="!!state.exportBusy"><i class="fa fa-download" aria-hidden="true"/> Export Excel</button>
                                        <button type="button" t-if="state.enableCsv" class="tl-ai-button tl-ai-ghost" t-on-click="() => this.exportResult(block, 'csv')" t-att-disabled="!!state.exportBusy">CSV</button>
                                        <span class="tl-ai-muted">Exports recheck your access and refresh the data.</span>
                                    </div>
                                </section>
                                <div t-elif="block.type === 'download'" class="tl-ai-download"><button type="button" class="tl-ai-button" t-on-click="() => this.openDownload(block.url)"><i class="fa fa-download" aria-hidden="true"/> <t t-esc="block.label"/></button></div>
                                <div t-elif="block.type === 'kpi'" class="tl-ai-legacy-kpi"><span t-foreach="block.items" t-as="item" t-key="item.label"><t t-esc="item.label"/>: <strong><t t-esc="item.value"/></strong></span></div>
                            </t>
                            <div t-if="!msg.streaming" class="tl-ai-answer-actions"><button type="button" class="tl-ai-button tl-ai-ghost" t-on-click="() => this.copyAnswer(msg)" aria-label="Copy answer" title="Copy answer"><i class="fa fa-copy" aria-hidden="true"/> Copy answer</button></div>
                        </t>
                    </article>
                    <div t-if="state.loading" class="tl-ai-thinking" role="status"><i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/> <t t-esc="state.status"/></div>
                    <div t-if="state.historyLoading" class="tl-ai-thinking" role="status">Loading conversation...</div>
                </div>
            </div>
            <footer class="tl-ai-composer-area">
                <div t-if="state.showLatest" class="tl-ai-latest-wrap"><button type="button" class="tl-ai-button tl-ai-latest" t-on-click="jumpToLatest"><i class="fa fa-arrow-down" aria-hidden="true"/> Jump to latest</button></div>
                <div t-if="state.error" class="tl-ai-error" role="alert"><t t-esc="state.error"/></div>
                <div class="tl-ai-composer"><textarea t-ref="input" rows="2" maxlength="12000" aria-label="Message" placeholder="Ask about your business..." dir="auto" t-att-value="state.input" t-on-input="onInput" t-on-keydown="onKeydown" t-att-disabled="state.historyLoading"/><button type="button" t-if="state.loading" class="tl-ai-send" aria-label="Stop response" title="Stop response" t-on-click="stopResponse"><i class="fa fa-stop" aria-hidden="true"/></button><button type="button" t-else="" class="tl-ai-send" aria-label="Send message" title="Send message" t-on-click="sendMessage" t-att-disabled="busy || !state.input.trim() || !state.provider"><i class="fa fa-arrow-up" aria-hidden="true"/></button></div>
                <p class="tl-ai-disclaimer">Enter to send · Shift+Enter for a new line · Read-only reporting</p>
            </footer>
        </main>
    </t>
    <t t-name="tradeline_ai_copilot.FloatingWidget">
        <div t-if="state.canAccess and state.open" t-att-class="rootClass"><div class="tl-ai-panel" t-ref="panel" t-on-keydown="onPanelKeydown"><t t-call="tradeline_ai_copilot.PanelContent"/></div></div>
        <button type="button" t-if="state.canAccess and !state.open" class="tl-ai-launcher" t-on-click="toggleOpen" title="Chat with Odoo" aria-label="Open Chat with Odoo"><img src="/tradeline_ai_copilot/static/src/img/tradeline_ai_mark.svg" alt="" width="34" height="34"/></button>
    </t>
    <t t-name="tradeline_ai_copilot.WorkspaceAction"><div class="tl-ai-workspace-page"><div t-if="state.canAccess" t-att-class="rootClass"><div class="tl-ai-panel" t-ref="panel" t-on-keydown="onPanelKeydown"><t t-call="tradeline_ai_copilot.PanelContent"/></div></div><p t-else="" class="p-4" role="status">Access requires the Tradeline AI / Reporting User group. Contact your administrator.</p></div></t>
</templates>
