<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_approvals" model="res.groups">
        <field name="name">Approvals</field>
        <field name="category_id" ref="base.module_category_human_resources_approvals"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('approvals.group_approval_user'))]"/>
        <field name="comment">Open the Approvals application and use its payment, cost, selling price, margin, and total fields.</field>
    </record>

    <!-- Access must be assigned explicitly, including for Settings administrators. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('approval_request_pricing.group_approvals'))]"/>
    </record>

    <record id="approvals.approvals_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('approval_request_pricing.group_approvals')])]"/>
    </record>
</odoo>
