<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_product_line_view_tree_pricing" model="ir.ui.view">
        <field name="name">approval.product.line.view.list.pricing</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals_purchase.approval_purchase_product_line_view_tree_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='seller_id']" position="after">
                <field name="currency_id" column_invisible="True"/>
                <field name="unit_cost" column_invisible="parent.approval_type != 'purchase'" readonly="1"/>
                <field name="selling_price" column_invisible="parent.approval_type != 'purchase'"/>
                <field name="margin" column_invisible="parent.approval_type != 'purchase'" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="approval_product_line_view_form_pricing" model="ir.ui.view">
        <field name="name">approval.product.line.view.form.pricing</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals.approval_product_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="currency_id" invisible="1"/>
                <field name="unit_cost" readonly="1"/>
                <field name="selling_price"/>
                <field name="margin" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
