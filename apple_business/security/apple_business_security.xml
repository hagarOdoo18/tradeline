<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_apple_business" model="ir.module.category">
        <field name="name">Apple Business</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_apple_business_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_apple_business"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_apple_business_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_apple_business"/>
        <field name="implied_ids" eval="[(4, ref('group_apple_business_user'))]"/>
    </record>

    <record id="apple_business_branch_rule" model="ir.rule">
        <field name="name">Apple Business: current user's branches</field>
        <field name="model_id" ref="model_apple_business"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('branch_id', 'in', user.branch_ids.ids)]</field>
    </record>

    <record id="apple_business_device_line_branch_rule" model="ir.rule">
        <field name="name">Apple Business devices: current user's branches</field>
        <field name="model_id" ref="model_apple_business_device_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('apple_business_id.branch_id', 'in', user.branch_ids.ids)]</field>
    </record>
</odoo>
