<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_executive_daily_landscape" model="report.paperformat">
        <field name="name">Executive Report Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">4</field>
        <field name="margin_bottom">4</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_executive_daily_pdf" model="ir.actions.report">
        <field name="name">Executive Report</field>
        <field name="model">tradeline.executive.report.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tradeline_executive_pocket_dashboard.report_executive_daily_document</field>
        <field name="report_file">tradeline_executive_pocket_dashboard.report_executive_daily_document</field>
        <field name="paperformat_id" ref="paperformat_executive_daily_landscape"/>
        <field name="print_report_name">'%s %s - %s' % (object.company_id.name, object.report_title(), object.report_date)</field>
    </record>

    <template id="report_executive_header">
        <div class="er-header">
            <div class="er-brand">
                <img t-att-class="'er-logo er-logo-xprs' if 'xprs' in (o.company_id.name or '').lower() else 'er-logo er-logo-tradeline'" t-att-src="o.report_logo_data_uri()"/>
                <div class="er-brand-copy">
                    <div class="er-product">Executive Pocket</div>
                    <div class="er-company"><span t-esc="o.company_id.name"/></div>
                </div>
            </div>
            <div class="er-report-meta">
                <div class="er-report-type"><span t-esc="o.report_title()"/></div>
                <div class="er-report-period"><span t-esc="o.report_period_label()"/></div>
            </div>
        </div>
    </template>

    <template id="report_executive_footer">
        <div class="er-footer">
            <div t-if="mostafa_enabled and page_number &gt; 1 and page_number &lt;= (3 + branch_page_count)" class="er-footer-mostafa">
                <strong>Mostafa Margin - XPRS executive adjustment:</strong>
                <span t-esc="mostafa_meta.get('disclosure')"/>
            </div>
            <div class="er-footer-row">
                <span>Confidential - generated from Odoo 18 reporting data</span>
                <span>Page <span t-esc="page_number"/> of <span t-esc="report_page_count"/></span>
            </div>
        </div>
    </template>

    <template id="report_executive_table">
        <section class="er-section-block">
            <div class="er-table-title"><span t-esc="title"/><span class="er-table-source" t-esc="source_label"/></div>
            <table class="er-table">
                <thead>
                    <tr t-if="table_kind == 'sales'">
                        <th class="er-rank">#</th><th class="er-dimension"><span t-esc="dimension_label"/></th>
                        <th class="er-num">Untaxed Revenue (EGP)</th><th class="er-num">Invoices (incl. credit notes)</th>
                        <th t-if="margin_available" class="er-num">Net Margin (EGP)</th>
                        <th t-if="margin_available" class="er-num">Net Margin %</th>
                        <th t-if="margin_available and mostafa_enabled" class="er-num er-mostafa-cell">Mostafa Margin (EGP)</th>
                        <th t-if="margin_available and mostafa_enabled" class="er-num er-mostafa-cell">Mostafa Margin %</th>
                    </tr>
                    <tr t-elif="table_kind == 'inventory'">
                        <th class="er-rank">#</th><th class="er-dimension"><span t-esc="dimension_label"/></th>
                        <th class="er-num">On-Hand Qty</th><th class="er-num">Allocated Value (EGP)</th>
                    </tr>
                    <tr t-else="">
                        <th class="er-rank">#</th><th class="er-dimension">Journal</th>
                        <th class="er-num">Collections (EGP)</th><th class="er-num">Payments</th><th class="er-num">Mix %</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows[row_offset:row_offset + row_limit]" t-as="row">
                        <td class="er-rank"><span t-esc="row_offset + row_index + 1"/></td>
                        <td class="er-dimension">
                            <span dir="auto" t-out="o.report_dimension_label(row.get('dimension'))"/>
                            <div class="er-inline-bar"><span t-att-style="'width:' + o.report_bar_width(row.get(value_key, 0), rows, value_key)"/></div>
                        </td>
                        <t t-if="table_kind == 'sales'">
                            <td class="er-num"><span t-esc="o.report_currency(row.get('net_revenue', 0))"/></td>
                            <td class="er-num"><span t-esc="o.report_number(row.get('invoice_count', 0))"/></td>
                            <td t-if="margin_available" class="er-num"><span t-esc="o.report_currency(row.get('net_margin', 0))"/></td>
                            <td t-if="margin_available" t-att-class="'er-num ' + ('er-negative' if (row.get('margin_pct') or 0) &lt; 0 else 'er-positive')"><span t-esc="o.report_percent(row.get('margin_pct', 0))"/></td>
                            <td t-if="margin_available and mostafa_enabled" class="er-num er-mostafa-cell"><span t-esc="o.report_currency(row.get('mostafa_margin', 0))"/></td>
                            <td t-if="margin_available and mostafa_enabled" t-att-class="'er-num er-mostafa-cell ' + ('er-negative' if (row.get('mostafa_margin_pct') or 0) &lt; 0 else 'er-positive')"><span t-esc="o.report_percent(row.get('mostafa_margin_pct', 0))"/></td>
                        </t>
                        <t t-elif="table_kind == 'inventory'">
                            <td class="er-num"><span t-esc="o.report_number(row.get('on_hand_qty', 0))"/></td>
                            <td class="er-num"><span t-esc="o.report_currency(row.get('allocated_value', 0))"/></td>
                        </t>
                        <t t-else="">
                            <td class="er-num"><span t-esc="o.report_currency(row.get('collections_total', 0))"/></td>
                            <td class="er-num"><span t-esc="o.report_number(row.get('payment_count', 0))"/></td>
                            <td class="er-num"><span t-esc="o.report_percent(row.get('share_pct', 0))"/></td>
                        </t>
                    </tr>
                    <tr t-if="not rows[row_offset:row_offset + row_limit]"><td colspan="6" class="er-empty">No data available for this report scope.</td></tr>
                </tbody>
            </table>
        </section>
    </template>

    <template id="report_executive_daily_document">
        <t t-call="web.html_container">
            <style>
                body { margin:0; background:#fff; color:#101d17; font-family:DejaVu Sans, Arial, sans-serif; font-size:9px; }
                .er-report-stack { width:100%; padding:0; }
                .page { position:relative; box-sizing:border-box; width:auto; min-height:286mm; margin:0; background:#fff; padding:0 1mm 10mm; page-break-after:always; }
                .page:last-child { page-break-after:auto; }
                .er-header { display:table; width:100%; box-sizing:border-box; border-bottom:1.5px solid #0b4a32; padding:1mm 0 3mm; margin-bottom:5mm; }
                .er-brand,.er-report-meta { display:table-cell; vertical-align:middle; }
                .er-report-meta { text-align:right; }
                .er-logo { vertical-align:middle; height:auto; }
                .er-logo-xprs { width:34mm; max-height:12mm; }
                .er-logo-tradeline { width:12mm; max-height:12mm; }
                .er-brand-copy { display:inline-block; vertical-align:middle; padding-left:2.5mm; }
                .er-product { font-family:DejaVu Serif, Georgia, serif; color:#0b4a32; font-size:17px; font-weight:700; line-height:1; }
                .er-company { color:#66756e; font-size:8px; letter-spacing:.08em; text-transform:uppercase; margin-top:1.2mm; }
                .er-report-type { color:#0b4a32; font-size:11px; font-weight:700; }
                .er-report-period { color:#66756e; font-size:8px; margin-top:1mm; }
                .er-page-heading { font-family:DejaVu Serif, Georgia, serif; color:#101d17; font-size:25px; line-height:1.05; margin:0 0 2mm; font-weight:700; }
                .er-page-intro { color:#66756e; font-size:8px; margin-bottom:5mm; }
                .er-heading-rule { width:14mm; height:2px; background:#0b4a32; margin:3mm 0 4mm; }
                .er-footer { position:absolute; left:2mm; right:2mm; bottom:0; width:auto; box-sizing:border-box; border-top:1px solid #d9e1dd; padding-top:1.2mm; color:#74827b; font-size:6.6px; }
                .er-footer-row { display:table; width:100%; }
                .er-footer-row > span:last-child { float:right; }
                .er-footer-mostafa { color:#315f4d; font-size:5.3px; line-height:1.25; margin-bottom:1mm; }
                .er-footer-mostafa strong { color:#0b4a32; }
                .er-hero-grid { display:table; width:100%; table-layout:fixed; border-spacing:2mm; margin-left:-2mm; margin-bottom:2mm; }
                .er-hero-metric { display:table-cell; width:25%; border-top:2px solid #0b4a32; background:#f3f7f5; padding:3mm; }
                .er-metric-label { color:#66756e; font-size:6px; text-transform:uppercase; letter-spacing:.08em; font-weight:700; }
                .er-metric-value { color:#101d17; font-size:17px; line-height:1.1; font-weight:700; margin:2mm 0 1mm; }
                .er-metric-note { color:#66756e; font-size:6px; line-height:1.35; }
                .er-kpi-grid { display:table; width:100%; table-layout:fixed; border-spacing:1.5mm; margin-left:-1.5mm; }
                .er-kpi-row { display:table-row; }
                .er-kpi { display:table-cell; width:25%; border:1px solid #d9e1dd; padding:2.5mm; vertical-align:top; }
                .er-kpi .er-metric-value { font-size:13px; }
                .er-subhead { font-family:DejaVu Serif, Georgia, serif; font-size:11px; color:#0b4a32; margin:4mm 0 2mm; font-weight:700; }
                .er-alerts { border:1px solid #ead8bf; background:#fffaf2; padding:2.5mm 3mm; }
                .er-alert { display:inline-block; width:31%; vertical-align:top; color:#714313; margin-right:2%; }
                .er-alert strong { display:block; font-size:7px; margin-bottom:.7mm; }
                .er-snapshot { width:100%; border-collapse:collapse; table-layout:fixed; }
                .er-snapshot td { border-right:1px solid #d9e1dd; padding:2.2mm; vertical-align:top; }
                .er-snapshot td:last-child { border-right:0; background:#edf6f1; }
                .er-snapshot-date { color:#66756e; font-size:6px; }
                .er-snapshot-value { color:#101d17; font-size:10px; font-weight:700; margin-top:1.5mm; }
                .er-snapshot-count { color:#66756e; font-size:6px; margin-top:.7mm; }
                .er-section-block { margin-bottom:4mm; page-break-inside:avoid; }
                .er-table-title { font-family:DejaVu Serif, Georgia, serif; color:#0b4a32; font-size:11px; font-weight:700; border-bottom:1.5px solid #0b4a32; padding:0 0 2mm; margin-bottom:0; }
                .er-table-source { float:right; font-family:DejaVu Sans, Arial, sans-serif; color:#66756e; font-size:6px; font-weight:400; padding-top:1.2mm; }
                .er-table { width:100%; border-collapse:collapse; table-layout:fixed; }
                .er-table th { background:#f3f7f5; color:#4f6158; font-size:5.8px; text-align:left; text-transform:uppercase; letter-spacing:.04em; padding:1.5mm 1.2mm; border-bottom:1px solid #d9e1dd; }
                .er-table td { padding:1.3mm 1.2mm; border-bottom:1px solid #e8eeeb; font-size:6.3px; line-height:1.2; vertical-align:middle; }
                .er-table tbody tr:nth-child(even) td { background:#fbfcfb; }
                .er-table .er-rank { width:5%; text-align:center; color:#78877f; }
                .er-table .er-dimension { width:39%; word-wrap:break-word; }
                .er-table .er-num { text-align:right; }
                .er-table .er-mostafa-cell { background:#edf8f3; color:#07593b; font-weight:700; }
                .er-inline-bar { height:1.1px; width:100%; background:#e6ece9; margin-top:.8mm; }
                .er-inline-bar span { display:block; height:100%; background:#137b50; }
                .er-positive { color:#137347; }
                .er-negative { color:#b43b32; }
                .er-empty { text-align:center; color:#66756e; padding:7mm !important; }
                .er-trend-card { border:1px solid #d9e1dd; padding:3mm; margin-bottom:4mm; }
                .er-trend-chart { width:100%; height:43mm; display:block; margin-top:2mm; }
                .er-trend-summary { color:#66756e; font-size:6px; margin-top:1.5mm; }
                .er-definition { border-left:2px solid #0b4a32; background:#f3f7f5; color:#596a62; padding:2.5mm 3mm; font-size:6.3px; line-height:1.45; margin-top:3mm; }
                .er-summary-page .er-header { margin-bottom:8mm; }
                .er-summary-page .er-page-heading { font-size:34px; margin-bottom:3mm; }
                .er-summary-page .er-page-intro { font-size:10px; line-height:1.5; margin-bottom:8mm; }
                .er-summary-page .er-hero-grid { margin-bottom:7mm; }
                .er-summary-page .er-hero-metric { padding:5mm 4mm; }
                .er-summary-page .er-metric-label { font-size:8px; }
                .er-summary-page .er-hero-metric .er-metric-value { font-size:23px; margin:3mm 0 2mm; }
                .er-summary-page .er-metric-note { font-size:8px; line-height:1.45; }
                .er-summary-page .er-subhead { font-size:15px; margin:7mm 0 3mm; }
                .er-summary-page .er-kpi { padding:4.5mm 3.5mm; }
                .er-summary-page .er-kpi .er-metric-value { font-size:19px; margin:2.5mm 0 1.5mm; }
                .er-summary-page .er-snapshot td { padding:4mm 3mm; }
                .er-summary-page .er-snapshot-date { font-size:8px; }
                .er-summary-page .er-snapshot-value { font-size:14px; margin-top:2mm; }
                .er-summary-page .er-snapshot-count { font-size:8px; margin-top:1.2mm; }
                .er-summary-page .er-alerts { padding:4mm; }
                .er-summary-page .er-alert { font-size:9px; line-height:1.4; }
                .er-summary-page .er-alert strong { font-size:9px; }
                .er-data-page .er-header { margin-bottom:6mm; }
                .er-data-page .er-page-heading { font-size:32px; }
                .er-data-page .er-heading-rule { margin-bottom:5mm; }
                .er-data-page .er-section-block { margin-bottom:6mm; }
                .er-data-page .er-table-title { font-size:14px; padding-bottom:2.5mm; }
                .er-data-page .er-table-source { font-size:7px; }
                .er-data-page .er-table th { font-size:7.2px; padding:2mm 1.4mm; }
                .er-data-page .er-table td { font-size:8.2px; line-height:1.25; padding:2mm 1.4mm; }
                .er-data-page .er-definition { font-size:8px; line-height:1.45; padding:4mm; margin-top:5mm; }
                .er-commercial-page .er-section-block { margin-bottom:4.5mm; }
                .er-commercial-page .er-table-title { font-size:13.5px; padding-bottom:2mm; }
                .er-commercial-page .er-table th { font-size:6.9px; padding:1.6mm 1.2mm; }
                .er-commercial-page .er-table td { font-size:7.8px; line-height:1.2; padding:1.45mm 1.2mm; }
                .er-sales-page .er-table td,
                .er-inventory-page .er-table td { padding-top:2.6mm; padding-bottom:2.6mm; }
                .er-branch-page .er-table td { padding-top:1.8mm; padding-bottom:1.8mm; }
                .er-trend-page .er-trend-chart { height:72mm; }
                .er-trend-page .er-trend-card { padding:4mm; margin-bottom:7mm; }
                .er-trend-page .er-subhead { font-size:15px; margin:6mm 0 3mm; }
                @media screen {
                    .er-report-stack { padding:0; }
                    .page { width:auto; min-height:286mm; margin:0; padding:0 1mm 10mm; box-shadow:none; }
                }
                @media print {
                    body { background:#fff; }
                    .page { min-height:286mm; }
                }
            </style>
            <div class="er-report-stack">
                <t t-foreach="docs" t-as="o">
                    <t t-set="payload" t-value="o.get_report_payload()"/>
                    <t t-set="top" t-value="payload.get('top_sections', {})"/>
                    <t t-set="cards" t-value="payload.get('cards', [])"/>
                    <t t-set="snapshot" t-value="payload.get('sections', {}).get('daily_snapshot', {}).get('rows', [])"/>
                    <t t-set="margin_available" t-value="payload.get('meta', {}).get('margin_status', {}).get('available', False)"/>
                    <t t-set="mostafa_meta" t-value="payload.get('meta', {}).get('mostafa_margin', {})"/>
                    <t t-set="mostafa_enabled" t-value="mostafa_meta.get('enabled', False)"/>
                    <t t-set="branch_pages" t-value="top.get('sales_by_branch_pages') or [top.get('sales_by_branch', [])]"/>
                    <t t-set="branch_page_count" t-value="len(branch_pages)"/>
                    <t t-set="report_page_count" t-value="6 + branch_page_count"/>
                    <t t-set="row_offset" t-value="0"/>
                    <t t-set="row_limit" t-value="10"/>

                    <div class="page er-summary-page">
                        <t t-call="tradeline_executive_pocket_dashboard.report_executive_header"/>
                        <h1 class="er-page-heading"><span t-esc="o.report_title()"/></h1>
                        <div class="er-heading-rule"></div>
                        <div class="er-page-intro">A concise view of sales, commercial performance, inventory exposure, and collections. Compact values: K = thousand, M = million, B = billion. Detailed tables show exact EGP amounts.</div>
                        <div class="er-hero-grid">
                            <div class="er-hero-metric"><div class="er-metric-label">Today's Sales</div><div class="er-metric-value" t-esc="o.report_compact(top.get('today_sales'), 'EGP ')"/><div class="er-metric-note">Sales on selected Daily Report Day</div></div>
                            <div class="er-hero-metric"><div class="er-metric-label">Acc. Sales (MTD)</div><div class="er-metric-value" t-esc="o.report_compact(top.get('acc_sales'), 'EGP ')"/><div class="er-metric-note">Month Day 1 through report day</div></div>
                            <div class="er-hero-metric"><div class="er-metric-label">Care Cards Rate</div><div class="er-metric-value" t-esc="o.report_percent(top.get('attachment_rate'))"/><div class="er-metric-note">Selected period, refunds excluded</div></div>
                            <div class="er-hero-metric"><div class="er-metric-label">Invoices (Incl. Credit Notes)</div><div class="er-metric-value" t-esc="o.report_number(top.get('total_invoices'))"/><div class="er-metric-note">Posted on report day</div></div>
                        </div>
                        <div class="er-subhead">Executive KPI Summary</div>
                        <div class="er-kpi-grid">
                            <div class="er-kpi-row">
                                <div class="er-kpi" t-foreach="cards[:4]" t-as="card"><div class="er-metric-label" t-esc="card.get('label')"/><div class="er-metric-value" t-esc="o.report_card_value(card)"/><div class="er-metric-note" t-esc="card.get('subtext') or ''"/></div>
                            </div>
                            <div class="er-kpi-row">
                                <div class="er-kpi" t-foreach="cards[4:8]" t-as="card"><div class="er-metric-label" t-esc="card.get('label')"/><div class="er-metric-value" t-esc="o.report_card_value(card)"/><div class="er-metric-note" t-esc="card.get('subtext') or ''"/></div>
                            </div>
                            <div class="er-kpi-row" t-if="cards[8:12]">
                                <div class="er-kpi" t-foreach="cards[8:12]" t-as="card"><div class="er-metric-label" t-esc="card.get('label')"/><div class="er-metric-value" t-esc="o.report_card_value(card)"/><div class="er-metric-note" t-esc="card.get('subtext') or ''"/></div>
                            </div>
                        </div>
                        <div class="er-subhead">7-Day Daily Snapshot</div>
                        <table class="er-snapshot"><tbody><tr>
                            <td t-foreach="snapshot[-7:]" t-as="row"><div class="er-snapshot-date" t-esc="row.get('date')"/><div class="er-snapshot-value" t-esc="o.report_compact(row.get('net_revenue'), 'EGP ')"/><div class="er-snapshot-count"><span t-esc="o.report_number(row.get('invoice_count'))"/> docs incl. credit notes</div></td>
                        </tr></tbody></table>
                        <div class="er-subhead" t-if="payload.get('alerts')">Alerts</div>
                        <div class="er-alerts" t-if="payload.get('alerts')"><div class="er-alert" t-foreach="payload.get('alerts', [])[:3]" t-as="alert"><strong t-esc="alert.get('label')"/><span t-esc="alert.get('detail')"/></div></div>
                        <t t-set="page_number" t-value="1"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_footer"/>
                    </div>

                    <div class="page er-data-page er-sales-page er-branch-page" t-foreach="branch_pages" t-as="branch_rows">
                        <t t-call="tradeline_executive_pocket_dashboard.report_executive_header"/>
                        <h1 class="er-page-heading">Sales Performance</h1><div class="er-heading-rule"></div>
                        <t t-set="title" t-value="'All Branches' if branch_page_count == 1 else 'All Branches - Part %s of %s' % (branch_rows_index + 1, branch_page_count)"/><t t-set="rows" t-value="branch_rows"/><t t-set="row_offset" t-value="0"/><t t-set="row_limit" t-value="18"/><t t-set="dimension_label" t-value="'Branch'"/><t t-set="source_label" t-value="'Every selected-company branch - exact amounts in EGP'"/><t t-set="table_kind" t-value="'sales'"/><t t-set="value_key" t-value="'net_revenue'"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_table"/>
                        <div class="er-definition">Every branch in the selected company is listed, including branches with zero posted invoice activity in the report period. Revenue is untaxed; invoice counts include posted customer invoices, receipts, and credit notes.</div>
                        <t t-set="page_number" t-value="2 + branch_rows_index"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_footer"/>
                    </div>

                    <div class="page er-data-page er-sales-page">
                        <t t-call="tradeline_executive_pocket_dashboard.report_executive_header"/>
                        <h1 class="er-page-heading">Sales Leadership</h1><div class="er-heading-rule"></div>
                        <t t-set="row_offset" t-value="0"/><t t-set="row_limit" t-value="10"/><t t-set="source_label" t-value="'Exact amounts in EGP'"/>
                        <t t-set="title" t-value="'Top 10 by Salesperson'"/><t t-set="rows" t-value="top.get('sales_by_salesperson', [])"/><t t-set="dimension_label" t-value="'Salesperson'"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_table"/>
                        <div class="er-definition">Invoice counts include posted customer invoices, receipts, and credit notes. Revenue is untaxed. Net Margin uses real stock valuation COGS; Net Margin % is Net Margin divided by the signed untaxed revenue basis used by Odoo's real COGS margin analysis. <span t-if="mostafa_enabled">Mostafa Margin is an XPRS-only executive adjustment that adds back actual reason-tagged untaxed discounts; Mostafa Margin % is Mostafa Margin divided by that same Odoo margin-analysis revenue basis. It does not alter Odoo accounting margin.</span></div>
                        <t t-set="page_number" t-value="2 + branch_page_count"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_footer"/>
                    </div>

                    <div class="page er-data-page er-commercial-page">
                        <t t-call="tradeline_executive_pocket_dashboard.report_executive_header"/>
                        <h1 class="er-page-heading">Commercial Mix</h1><div class="er-heading-rule"></div>
                        <t t-set="row_offset" t-value="0"/><t t-set="row_limit" t-value="10"/><t t-set="source_label" t-value="'Exact amounts in EGP'"/>
                        <t t-set="title" t-value="'Top 10 by Category'"/><t t-set="rows" t-value="top.get('sales_by_category', [])"/><t t-set="dimension_label" t-value="'Category'"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_table"/>
                        <t t-set="title" t-value="'Top 10 Customers'"/><t t-set="rows" t-value="top.get('sales_by_customer', [])"/><t t-set="dimension_label" t-value="'Customer'"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_table"/>
                        <t t-set="title" t-value="'Top 10 by Product Variant'"/><t t-set="rows" t-value="top.get('sales_by_product', [])"/><t t-set="dimension_label" t-value="'Product Variant'"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_table"/>
                        <t t-set="page_number" t-value="3 + branch_page_count"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_footer"/>
                    </div>

                    <div class="page er-data-page er-inventory-page">
                        <t t-call="tradeline_executive_pocket_dashboard.report_executive_header"/>
                        <h1 class="er-page-heading">Inventory Exposure</h1><div class="er-heading-rule"></div>
                        <t t-set="row_offset" t-value="0"/><t t-set="row_limit" t-value="10"/>
                        <t t-set="title" t-value="'Top 10 by Category'"/><t t-set="rows" t-value="top.get('inventory_by_category', [])"/><t t-set="dimension_label" t-value="'Category'"/><t t-set="source_label" t-value="'Allocated cost in EGP (SVL method)'"/><t t-set="table_kind" t-value="'inventory'"/><t t-set="value_key" t-value="'allocated_value'"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_table"/>
                        <t t-set="title" t-value="'Top 10 by Product Family'"/><t t-set="rows" t-value="top.get('inventory_by_family', [])"/><t t-set="dimension_label" t-value="'Product Family'"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_table"/>
                        <div class="er-definition">Inventory uses internal-location stock quantities and allocated stock valuation layer cost as of the report day. Product Family comes from the native Odoo product family assigned to each product template.</div>
                        <t t-set="page_number" t-value="4 + branch_page_count"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_footer"/>
                    </div>

                    <div class="page er-data-page er-inventory-page">
                        <t t-call="tradeline_executive_pocket_dashboard.report_executive_header"/>
                        <h1 class="er-page-heading">Inventory Product Detail</h1><div class="er-heading-rule"></div>
                        <t t-set="row_offset" t-value="0"/><t t-set="row_limit" t-value="10"/>
                        <t t-set="source_label" t-value="'Allocated cost in EGP (SVL method)'"/><t t-set="table_kind" t-value="'inventory'"/><t t-set="value_key" t-value="'allocated_value'"/>
                        <t t-set="title" t-value="'Top 10 by Product Variant'"/><t t-set="rows" t-value="top.get('inventory_by_product', [])"/><t t-set="dimension_label" t-value="'Product Variant'"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_table"/>
                        <div class="er-definition">Inventory uses internal-location stock quantities and allocated stock valuation layer cost as of the report day. Product rows remain at variant level.</div>
                        <t t-set="page_number" t-value="5 + branch_page_count"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_footer"/>
                    </div>

                    <div class="page er-data-page er-trend-page">
                        <t t-call="tradeline_executive_pocket_dashboard.report_executive_header"/>
                        <h1 class="er-page-heading">Sales Trend</h1><div class="er-heading-rule"></div>
                        <t t-set="row_offset" t-value="0"/><t t-set="row_limit" t-value="10"/>
                        <t t-set="trend_chart" t-value="o.report_trend_chart(top.get('sales_over_month', []))"/>
                        <section class="er-trend-card">
                            <div class="er-table-title">Untaxed Revenue MTD (EGP)<span class="er-table-source">K = thousand - M = million - B = billion</span></div>
                            <t t-if="trend_chart.get('line')">
                                <svg class="er-trend-chart" viewBox="0 0 520 145" preserveAspectRatio="xMidYMid meet">
                                    <defs><linearGradient id="erTrendArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#137b50" stop-opacity="0.24"/><stop offset="100%" stop-color="#137b50" stop-opacity="0.02"/></linearGradient></defs>
                                    <g t-foreach="trend_chart.get('y_ticks')" t-as="tick">
                                        <line t-att-x1="trend_chart.get('axis_left')" t-att-y1="tick.get('y')" t-att-x2="trend_chart.get('axis_right')" t-att-y2="tick.get('y')" stroke="#d9e1dd" stroke-width="0.7"/>
                                        <text x="53" t-att-y="tick.get('y') + 2" text-anchor="end" fill="#66756e" font-size="7.5"><t t-esc="tick.get('label')"/></text>
                                    </g>
                                    <g t-foreach="trend_chart.get('x_ticks')" t-as="tick">
                                        <line t-att-x1="tick.get('x')" t-att-y1="trend_chart.get('axis_top')" t-att-x2="tick.get('x')" t-att-y2="trend_chart.get('axis_bottom')" stroke="#edf1ef" stroke-width="0.6"/>
                                        <text t-att-x="tick.get('x')" y="139" t-att-text-anchor="tick.get('anchor')" fill="#66756e" font-size="7.5"><t t-esc="tick.get('label')"/></text>
                                    </g>
                                    <line t-att-x1="trend_chart.get('axis_left')" t-att-y1="trend_chart.get('zero_y')" t-att-x2="trend_chart.get('axis_right')" t-att-y2="trend_chart.get('zero_y')" stroke="#9bada4" stroke-width="1"/>
                                    <path t-att-d="trend_chart.get('area')" fill="url(#erTrendArea)" stroke="none"/>
                                    <path t-att-d="trend_chart.get('line')" fill="none" stroke="#0b4a32" stroke-width="2.3" stroke-linejoin="round" stroke-linecap="round"/>
                                    <circle t-foreach="trend_chart.get('points')" t-as="point" t-att-cx="point.get('x')" t-att-cy="point.get('y')" r="2.5" fill="#0b4a32" stroke="#ffffff" stroke-width="1"/>
                                </svg>
                                <div class="er-trend-summary">MTD total: <strong t-esc="o.report_compact(trend_chart.get('total'), 'EGP ')"/>. Daily range: <span t-esc="o.report_compact(trend_chart.get('low'), 'EGP ')"/> to <span t-esc="o.report_compact(trend_chart.get('high'), 'EGP ')"/>. Missing activity days are plotted as zero.</div>
                            </t>
                            <div t-else="" class="er-empty">No month-to-date trend data available.</div>
                        </section>
                        <div class="er-subhead">Collections Mix</div>
                        <t t-set="title" t-value="'Top 10 Payment Journals'"/><t t-set="rows" t-value="top.get('payment_journals', [])"/><t t-set="dimension_label" t-value="'Journal'"/><t t-set="source_label" t-value="'Exact EGP - Reporting Payment Excel Report'"/><t t-set="table_kind" t-value="'journals'"/><t t-set="value_key" t-value="'collections_total'"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_table"/>
                        <div class="er-definition">Open Unpaid Invoice Value follows Invoice Analysis untaxed amounts for selected-period invoices still unpaid on the report day. Collections follow the Reporting Payment Excel Report transaction source: reconciled invoice payments, POS payment fallbacks, credit notes, and sale-order payments, scoped by company, branch, and date.</div>
                        <t t-set="page_number" t-value="6 + branch_page_count"/><t t-call="tradeline_executive_pocket_dashboard.report_executive_footer"/>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
