<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_executive_report_schedule_list" model="ir.ui.view">
        <field name="name">tradeline.executive.report.schedule.list</field>
        <field name="model">tradeline.executive.report.schedule</field>
        <field name="arch" type="xml">
            <list decoration-success="active" decoration-muted="not active">
                <field name="company_id"/>
                <field name="active"/>
                <field name="recipient_emails"/>
                <field name="send_hour"/>
                <field name="timezone"/>
                <field name="top_n"/>
                <field name="last_sent_on"/>
                <field name="next_run_at"/>
            </list>
        </field>
    </record>

    <record id="view_executive_report_schedule_form" model="ir.ui.view">
        <field name="name">tradeline.executive.report.schedule.form</field>
        <field name="model">tradeline.executive.report.schedule</field>
        <field name="arch" type="xml">
            <form string="Executive Report Schedule">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="active"/>
                            <field name="recipient_emails" placeholder="name@example.com, another@example.com"/>
                        </group>
                        <group>
                            <field name="send_hour"/>
                            <field name="timezone"/>
                            <field name="top_n"/>
                            <field name="last_sent_on" readonly="1"/>
                            <field name="next_run_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Delivery History">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="report_date"/>
                                    <field name="report_scope"/>
                                    <field name="delivery_type"/>
                                    <field name="state"/>
                                    <field name="recipient_emails"/>
                                    <field name="sent_at"/>
                                    <field name="attachment_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_executive_report_history_list" model="ir.ui.view">
        <field name="name">tradeline.executive.report.history.list</field>
        <field name="model">tradeline.executive.report.history</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-success="state == 'sent'" decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="report_date"/>
                <field name="report_scope"/>
                <field name="delivery_type"/>
                <field name="state"/>
                <field name="recipient_emails"/>
                <field name="sent_at"/>
                <field name="attachment_id"/>
                <field name="error_message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_executive_report_schedules" model="ir.actions.act_window">
        <field name="name">Daily Report Schedules</field>
        <field name="res_model">tradeline.executive.report.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_executive_report_history" model="ir.actions.act_window">
        <field name="name">Report Delivery History</field>
        <field name="res_model">tradeline.executive.report.history</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_executive_report_schedules"
        name="Daily Report Schedules"
        parent="tradeline_executive_pocket_dashboard.menu_executive_pocket_operations"
        action="tradeline_executive_pocket_dashboard.action_executive_report_schedules"
        sequence="20"
        groups="tradeline_executive_pocket_dashboard.group_exec_admin"/>
    <menuitem id="menu_executive_report_history"
        name="Report Delivery History"
        parent="tradeline_executive_pocket_dashboard.menu_executive_pocket_operations"
        action="tradeline_executive_pocket_dashboard.action_executive_report_history"
        sequence="21"
        groups="tradeline_executive_pocket_dashboard.group_exec_admin"/>
</odoo>
