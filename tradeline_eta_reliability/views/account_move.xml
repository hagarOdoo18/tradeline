<odoo>
    <record id="view_move_form_draft_correction" model="ir.ui.view">
        <field name="name">account.move.form.eta.draft.correction</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="egyptian_electronic_invoice.e_invoice_view_move_form_inherit"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_send_electronic_invoice']" position="attributes">
                <attribute name="groups">tradeline_eta_reliability.group_eta_workspace</attribute>
                <attribute name="name">action_send_electronic_invoice</attribute>
                <attribute name="string">Sync</attribute>
                <attribute name="class">btn-primary</attribute>
                <attribute name="invisible">state != 'posted' or move_type not in ('out_invoice', 'out_refund') or eta_staff_state in ('valid', 'accepted') or not eta_user_is_admin</attribute>
            </xpath>
            <xpath expr="//button[@name='action_update_electronic_invoice_status']" position="attributes">
                <attribute name="name">action_eta_check_status_now</attribute>
                <attribute name="string">Update Status</attribute>
                <attribute name="groups">tradeline_eta_reliability.group_eta_workspace</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="eta_staff_state" invisible="1" groups="tradeline_eta_reliability.group_eta_workspace"/>
                <field name="eta_user_is_admin" invisible="1" groups="tradeline_eta_reliability.group_eta_workspace"/>
            </xpath>
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="eta_vat_original_id" invisible="not eta_vat_original_id"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_eta_vat_correction_form" model="ir.ui.view">
        <field name="name">tradeline.eta.vat.correction.form</field>
        <field name="model">tradeline.eta.vat.correction</field>
        <field name="arch" type="xml">
            <form string="Correct VAT">
                <p>Choose the correct VAT tax. An unsent or ETA-invalid invoice reopens in draft with VAT applied.</p>
                <p>An ETA-approved invoice uses the separate 14% VAT preview in Odoo only.
                    That amendment preserves the customer total and original ETA receipt, without a credit note,
                    replacement invoice or ETA request.</p>
                <group>
                    <field name="move_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="tax_id" options="{'no_create': True}"/>
                    <field name="adjustment_journal_id" options="{'no_create': True}"/>
                    <field name="reason"/>
                </group>
                <group string="Review the amounts before preparing">
                    <field name="currency_id" invisible="1"/>
                    <field name="price_treatment" nolabel="1" colspan="2"/>
                    <field name="original_total" string="Current customer total"/>
                    <field name="preview_untaxed" string="New amount before tax"/>
                    <field name="preview_tax" string="New tax amount"/>
                    <field name="preview_total" string="New customer total"/>
                    <field name="preview_difference" string="Change in customer total"/>
                </group>
                <p>For an unsent or confirmed-invalid invoice, preparing opens the same invoice in draft with VAT.
                    Review the totals before posting and using Sync. Approved invoices use the Odoo-only preview.</p>
                <footer>
                    <button name="action_prepare" string="Prepare VAT Correction" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_invoice_list_eta_staff_status" model="ir.ui.view">
        <field name="name">account.invoice.list.eta.staff.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="eta_staff_state" string="ETA status" widget="badge" groups="tradeline_eta_reliability.group_eta_workspace"
                    decoration-success="eta_staff_state == 'valid'"
                    decoration-danger="eta_staff_state in ('blocked', 'invalid')"
                    decoration-warning="eta_staff_state in ('unknown','delivery_review')"
                    decoration-info="eta_staff_state in ('queued', 'accepted', 'review')"/>
                <button name="action_eta_send_now" type="object" string="Sync" icon="fa-paper-plane"
                    groups="tradeline_eta_reliability.group_eta_workspace"
                    help="Check and send this invoice immediately without waiting for the backlog. Invoice validation and ETA-required waits still apply."
                    invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or eta_staff_state in ('valid', 'accepted')"/>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="eta_staff_reason" string="ETA issue / explanation" optional="hide" groups="tradeline_eta_reliability.group_eta_workspace"/>
                <field name="eta_staff_next_step" string="ETA next step" optional="hide" groups="tradeline_eta_reliability.group_eta_workspace"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_eta_single_controls" model="ir.ui.view">
        <field name="name">account.move.form.eta.single.controls</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_edi.view_move_form_inherit"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="before">
                <field name="eta_native_edi_only" invisible="1"/>
                <field name="eta_native_pending_only" invisible="1"/>
                <field name="eta_native_error_only" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='button_process_edi_web_services']/.." position="attributes">
                <attribute name="invisible" add="eta_native_pending_only" separator=" or "/>
            </xpath>
            <xpath expr="//div[@role='alert'][hasclass('alert-danger')][.//field[@name='edi_error_message']]" position="attributes">
                <attribute name="invisible" add="eta_native_error_only" separator=" or "/>
            </xpath>
            <xpath expr="//div[@role='alert'][hasclass('alert-warning')][.//field[@name='edi_error_message']]" position="attributes">
                <attribute name="invisible" add="eta_native_error_only" separator=" or "/>
            </xpath>
            <xpath expr="//div[@role='alert'][hasclass('alert-info')][.//field[@name='edi_error_message']]" position="attributes">
                <attribute name="invisible" add="eta_native_error_only" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='edi_state']" position="attributes">
                <attribute name="invisible" add="eta_native_edi_only" separator=" or "/>
            </xpath>
        </field>
    </record>
    <record id="view_invoice_search_eta_untracked" model="ir.ui.view">
        <field name="name">account.invoice.search.eta.untracked</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="eta_missing_tracking" string="ETA: no tracking or receipt"
                    domain="[('state', '=', 'posted'), ('move_type', 'in', ['out_invoice', 'out_refund']), ('eta_job_ids', '=', False), ('e_invoice_uuid', '=', False), ('l10n_eg_uuid', '=', False), ('e_invoice_sent', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
