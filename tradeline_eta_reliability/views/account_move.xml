<odoo>
    <record id="view_move_form_draft_correction" model="ir.ui.view">
        <field name="name">account.move.form.eta.draft.correction</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="egyptian_electronic_invoice.e_invoice_view_move_form_inherit"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_send_electronic_invoice']" position="attributes">
                <attribute name="groups">account.group_account_invoice</attribute>
                <attribute name="name">action_eta_send_now</attribute>
                <attribute name="string">Send to ETA now</attribute>
                <attribute name="class">btn-primary</attribute>
                <attribute name="invisible">state != 'posted' or move_type not in ('out_invoice', 'out_refund') or eta_staff_state in ('valid', 'accepted')</attribute>
            </xpath>
            <xpath expr="//button[@name='action_update_electronic_invoice_status']" position="attributes">
                <attribute name="name">action_eta_check_status_now</attribute>
                <attribute name="string">Check ETA status</attribute>
                <attribute name="groups">account.group_account_invoice</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_eta_check_status_now" string="Check ETA status" type="object"
                        icon="fa-refresh" groups="account.group_account_invoice"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_eta_correct_vat" string="Correct VAT" type="object"
                        groups="tradeline_eta_reliability.group_eta_workspace"
                        invisible="state != 'posted' or move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mx-3 my-2" role="status"
                     invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <strong>Egyptian Tax Authority</strong>
                        <field name="eta_staff_state" widget="badge"
                            decoration-success="eta_staff_state == 'valid'"
                            decoration-danger="eta_staff_state in ('blocked', 'invalid')"
                            decoration-warning="eta_staff_state in ('unknown','delivery_review')"
                            decoration-info="eta_staff_state in ('queued', 'accepted', 'review')"/>
                        <span invisible="eta_staff_state">No ETA submission recorded</span>
                    </div>
                    <div class="mb-1"><field name="eta_staff_reason" nolabel="1"/></div>
                    <div class="mb-2"><field name="eta_staff_next_step" nolabel="1"/></div>
                    <div class="d-flex gap-4 flex-wrap small">
                        <span>Last confirmed check: <field name="eta_staff_checked_at"/></span>
                        <span>Next automatic check: <field name="eta_staff_next_attempt"/></span>
                        <button name="action_eta_status_details" string="ETA details and issues" type="object" class="btn-link"
                            groups="tradeline_eta_reliability.group_eta_workspace"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="eta_vat_correction_ids" invisible="1"/>
                <button name="action_eta_vat_documents" string="VAT Corrections" type="object"
                        class="oe_stat_button" icon="fa-files-o" groups="tradeline_eta_reliability.group_eta_workspace" invisible="not eta_vat_correction_ids"/>
            </xpath>
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="eta_vat_original_id" invisible="not eta_vat_original_id"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_eta_vat_correction_form" model="ir.ui.view">
        <field name="name">tradeline.eta.vat.correction.form</field>
        <field name="model">tradeline.eta.vat.correction</field>
        <field name="arch" type="xml">
            <form string="Correct VAT">
                <p>Choose the correct VAT tax. An unsent or ETA-invalid invoice reopens in draft with VAT applied.</p>
                <p>For an ETA-valid invoice, prepare a linked credit note and replacement invoice. The credit note
                    matches the original ETA receipt. If Odoo was edited after submission, an accounting adjustment
                    draft reconciles that earlier edit. Review and post the credit note and any adjustment.
                    Once the credit note is Valid at ETA, post the replacement. The original receipt is preserved.</p>
                <group>
                    <field name="move_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="tax_id" options="{'no_create': True}"/>
                    <field name="adjustment_journal_id" options="{'no_create': True}"/>
                    <field name="reason"/>
                </group>
                <group string="Review the amounts before preparing">
                    <field name="currency_id" invisible="1"/>
                    <field name="price_treatment" nolabel="1" colspan="2"/>
                    <field name="original_total" string="Current customer total"/>
                    <field name="preview_untaxed" string="New amount before tax"/>
                    <field name="preview_tax" string="New tax amount"/>
                    <field name="preview_total" string="New customer total"/>
                    <field name="preview_difference" string="Change in customer total"/>
                </group>
                <p>Preparing saves drafts for review. It does not post entries or send anything to ETA.
                    For an approved original: review and post the credit, wait for ETA approval, then post and send the replacement.</p>
                <footer>
                    <button name="action_prepare" string="Prepare VAT Correction" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_invoice_list_eta_staff_status" model="ir.ui.view">
        <field name="name">account.invoice.list.eta.staff.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="eta_staff_state" string="ETA status" widget="badge" optional="show"
                    decoration-success="eta_staff_state == 'valid'"
                    decoration-danger="eta_staff_state in ('blocked', 'invalid')"
                    decoration-warning="eta_staff_state in ('unknown','delivery_review')"
                    decoration-info="eta_staff_state in ('queued', 'accepted', 'review')"/>
            </xpath>
        </field>
    </record>
    <record id="view_invoice_search_eta_untracked" model="ir.ui.view">
        <field name="name">account.invoice.search.eta.untracked</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="eta_missing_tracking" string="ETA: no tracking or receipt"
                    domain="[('state', '=', 'posted'), ('move_type', 'in', ['out_invoice', 'out_refund']), ('eta_job_ids', '=', False), ('e_invoice_uuid', '=', False), ('l10n_eg_uuid', '=', False), ('e_invoice_sent', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
