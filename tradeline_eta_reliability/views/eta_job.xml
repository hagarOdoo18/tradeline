<odoo>
    <record id="eta_job_list" model="ir.ui.view">
        <field name="name">tradeline.eta.job.list</field>
        <field name="model">tradeline.eta.job</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="state in ('blocked', 'invalid')" decoration-warning="state == 'unknown'">
                <field name="move_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="next_attempt"/>
                <field name="last_error"/>
            </list>
        </field>
    </record>
    <record id="eta_job_form" model="ir.ui.view">
        <field name="name">tradeline.eta.job.form</field>
        <field name="model">tradeline.eta.job</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header><button name="action_recheck" type="object" string="Recheck / retry corrected data" class="btn-primary"/></header>
                <sheet>
                    <group>
                        <field name="move_id"/><field name="company_id"/><field name="state"/>
                        <field name="attempts"/><field name="next_attempt"/><field name="attempted_at"/>
                        <field name="checked_at"/><field name="submission_uuid"/><field name="payload_hash"/>
                    </group>
                    <field name="last_error"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="eta_job_search" model="ir.ui.view">
        <field name="name">tradeline.eta.job.search</field>
        <field name="model">tradeline.eta.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <filter name="attention" string="Needs attention" domain="[('state', 'in', ['unknown', 'blocked', 'invalid'])]"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ['queued', 'accepted'])]"/>
                <group expand="0" string="Group By"><filter name="state" string="Status" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_eta_jobs" model="ir.actions.act_window">
        <field name="name">ETA Submission Jobs</field>
        <field name="res_model">tradeline.eta.job</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_eta_jobs" name="ETA Submission Jobs" parent="account.menu_finance" action="action_eta_jobs" groups="account.group_account_manager" sequence="95"/>
</odoo>
