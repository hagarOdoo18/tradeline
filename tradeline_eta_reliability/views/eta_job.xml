<odoo>
    <record id="eta_job_list" model="ir.ui.view">
        <field name="name">tradeline.eta.job.list</field>
        <field name="model">tradeline.eta.job</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="create_date desc,id desc" decoration-success="state == 'valid'" decoration-danger="state in ('blocked', 'invalid')" decoration-warning="state == 'unknown'" decoration-info="state == 'accepted'">
                <field name="move_id" string="Invoice"/><field name="journal_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" string="ETA status" widget="badge" decoration-success="state == 'valid'" decoration-danger="state in ('blocked', 'invalid')" decoration-warning="state == 'unknown'" decoration-info="state in ('queued', 'accepted', 'review')"/>
                <field name="staff_summary" class="text-wrap"/>
                <field name="required_action" class="text-wrap"/>
                <field name="waiting_minutes" string="Waiting (min)" optional="show"/>
                <field name="invoice_date" optional="hide"/>
                <field name="customer_id" optional="show"/>
                <field name="attempts" optional="hide"/>
                <field name="next_attempt" string="Next check / retry" optional="show"/>
                <field name="checked_at" string="Last confirmed check" optional="show"/>
                <field name="create_date" string="Queued on" optional="hide"/>
                <field name="write_date" string="Last updated" optional="hide"/>
                <field name="last_error" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="eta_job_form" model="ir.ui.view">
        <field name="name">tradeline.eta.job.form</field>
        <field name="model">tradeline.eta.job</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_send_now" type="object" string="Send to ETA now" class="btn-primary" icon="fa-paper-plane" groups="account.group_account_invoice" invisible="state in ('valid', 'accepted')"/>
                    <button name="action_check_status_now" type="object" string="Check ETA status" icon="fa-refresh" groups="account.group_account_invoice"/>
                    <button name="action_fix_customer" type="object" string="Customer details" groups="account.group_account_invoice"/>
                    <button name="action_open_invoice" type="object" string="Open invoice" class="btn-primary"/>
                    <button name="action_approve_current_issue_date" type="object" string="Approve current ETA issue date" groups="account.group_account_invoice,base.group_system" invisible="state not in ('queued', 'blocked')"/>

                </header>
                <sheet>
                    <group string="Why this invoice needs attention">
                        <field name="staff_summary" nolabel="1" colspan="2"/>
                        <field name="required_action" nolabel="1" colspan="2"/>
                    </group>
                    <group>
                        <field name="move_id" string="Invoice"/><field name="company_id"/><field name="state" string="ETA status" widget="badge" decoration-success="state == 'valid'" decoration-danger="state in ('blocked', 'invalid')" decoration-warning="state == 'unknown'" decoration-info="state in ('queued', 'accepted', 'review')"/>
                        <field name="invoice_date"/><field name="customer_id"/><field name="journal_id"/><field name="waiting_minutes"/>
                        <field name="create_date" string="Queued on"/><field name="write_date" string="Last updated"/>
                        <field name="attempts" groups="base.group_system"/><field name="next_attempt"/><field name="attempted_at"/>
                        <field name="checked_at"/><field name="submission_uuid" groups="base.group_system"/><field name="payload_hash" groups="base.group_system"/>
                        <field name="duplicate_retry_at" string="ETA cooldown until" invisible="not duplicate_retry_at"/>
                    </group>
                    <group string="Original ETA / processing message"><field name="last_error" nolabel="1"/></group>
                    <group string="ETA issue date treatment">
                        <field name="issue_date_policy"/>
                        <field name="current_issue_datetime"/>
                        <field name="issue_date_approved_by"/>
                        <field name="issue_date_approved_at"/>
                        <field name="issue_date_approval_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="eta_job_search" model="ir.ui.view">
        <field name="name">tradeline.eta.job.search</field>
        <field name="model">tradeline.eta.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="invoice_number" string="Invoice number" filter_domain="[('move_id.name', 'ilike', self)]"/>
                <field name="journal_id"/><field name="customer_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="last_error" string="ETA message"/>
                <filter name="attention" string="Needs attention" domain="[('needs_attention', '=', True)]"/>
                <separator/>
                <filter name="today" string="Today's invoices" domain="[('invoice_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="correction" string="Needs correction" domain="[('state', 'in', ['blocked', 'invalid'])]"/>
                <separator/>
                <filter name="customer_issue" string="Customer ID issues" domain="['|', '|', '|', ('last_error', 'ilike', 'national ID'), ('last_error', 'ilike', 'receiver ID'), ('last_error', 'ilike', 'tax ID'), ('last_error', 'ilike', 'NI30')]"/>
                <filter name="product_issue" string="Product code issues" domain="['|', ('last_error', 'ilike', 'CV302'), ('last_error', 'ilike', 'itemCode')]"/>
                <filter name="connection_issue" string="Connection / ETA access" domain="['|', '|', '|', '|', ('last_error', 'ilike', 'communication'), ('last_error', 'ilike', 'connection'), ('last_error', 'ilike', 'HTTP'), ('last_error', 'ilike', 'timeout'), ('last_error', 'ilike', 'unreadable response')]"/>
                <separator/>
                <filter name="historical" string="Earlier records under review" domain="[('state', '=', 'review')]"/>
                <filter name="pending" string="Waiting / received" domain="[('state', 'in', ['queued', 'accepted'])]"/>
                <separator/>
                <filter name="late_approval" string="Late approval needed" domain="['|', ('last_error', 'ilike', 'CF313'), ('last_error', 'ilike', 'outside the configured ETA submission window')]"/>
                <filter name="uncertain" string="Previous attempt unconfirmed" domain="[('state', '=', 'unknown')]"/>
                <filter name="duplicates" string="Duplicate / receipt conflict" domain="['|', ('last_error', 'ilike', 'DS301'), ('last_error', 'ilike', 'different document UUID')]"/>
                <filter name="date_review" string="Approved / date review" domain="[('state', '=', 'valid'), '|', ('last_error', 'ilike', 'issue date'), ('move_id.e_invoice_issue', 'ilike', 'issue date')]"/>
                <filter name="valid" string="Approved by ETA" domain="[('state', '=', 'valid')]"/>
                <group expand="0" string="Group By">
                    <filter name="branch" string="Branch / sales journal" context="{'group_by': 'journal_id'}"/>
                    <filter name="queued_day" string="Queued day" context="{'group_by': 'create_date:day'}"/>
                    <filter name="state" string="ETA status" context="{'group_by': 'state'}"/>
                    <filter name="company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_eta_jobs" model="ir.actions.act_window">
        <field name="name">ETA Submission Jobs</field>
        <field name="res_model">tradeline.eta.job</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_eta_invoice_log" model="ir.actions.act_window">
        <field name="name">ETA Status</field>
        <field name="res_model">tradeline.eta.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="eta_job_search"/>
        <field name="context">{'group_by': 'state'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No invoices match these filters.</p>
            <p>Search by invoice number across all statuses. Choose Needs attention to focus on issues, or group by branch, company or status.</p>
        </field>
    </record>
    <menuitem id="menu_eta_jobs" name="ETA Submission Jobs" parent="tradeline_operations_monitor.menu_operations_root" action="action_eta_jobs" groups="account.group_account_manager" sequence="16"/>
    <menuitem id="menu_account_eta_jobs" name="ETA Status" parent="account.menu_finance" action="action_eta_invoice_log" groups="account.group_account_invoice" sequence="95"/>
    <menuitem id="menu_operations_eta_log" name="ETA Invoice Log" parent="tradeline_operations_monitor.menu_operations_root" action="action_eta_invoice_log" groups="base.group_system" sequence="15"/>
    <function model="ir.ui.menu" name="_eta_place_staff_menu"/>
</odoo>
