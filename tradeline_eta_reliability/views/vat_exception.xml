<odoo>
    <record id="eta_vat_bypass_form" model="ir.ui.view">
        <field name="name">tradeline.eta.vat.bypass.form</field>
        <field name="model">tradeline.eta.vat.bypass</field>
        <field name="arch" type="xml">
            <form string="Send without VAT">
                <p>Send this invoice with its current taxes and amounts. This bypasses the local positive-VAT requirement only. ETA validation, earlier receipt checks and duplicate prevention still apply.</p>
                <p>Enter the exemption or other accounting reason. Your approval is recorded for this invoice and becomes invalid if its invoice details change.</p>
                <group>
                    <field name="move_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="reason" placeholder="Why should this invoice be sent without VAT?"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Approve and send without VAT" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_move_form_vat_exception" model="ir.ui.view">
        <field name="name">account.move.form.eta.vat.exception</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="view_move_form_draft_correction"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div role="status" class="alert alert-warning mb-0"
                    groups="tradeline_eta_reliability.group_eta_workspace"
                    invisible="move_type not in ('out_invoice','out_refund') or eta_staff_state not in ('blocked','invalid','unknown','delivery_review','review')">
                    <strong>ETA status: </strong><field name="eta_staff_state" widget="badge"/>
                    <div><field name="eta_staff_reason" nolabel="1"/></div>
                    <div><strong>Next step: </strong><field name="eta_staff_next_step" nolabel="1"/></div>
                    <button name="action_eta_status_details" type="object" string="Open ETA details" class="btn-link"/>
                </div>
            </xpath>
            <xpath expr="//header/button[@name='action_eta_send_now']" position="after">
                <button name="action_eta_send_without_vat" type="object" string="Send without VAT…"
                    groups="tradeline_eta_reliability.group_eta_workspace"
                    invisible="state != 'posted' or move_type != 'out_invoice' or eta_staff_state in ('valid','accepted')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="VAT exception" groups="tradeline_eta_reliability.group_eta_workspace">
                    <group>
                        <field name="eta_vat_review_state"/>
                        <field name="eta_vat_review_note"/>
                        <field name="eta_vat_bypass_reason"/>
                        <field name="eta_vat_bypass_by"/>
                        <field name="eta_vat_bypass_at"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="eta_job_form_vat_exception" model="ir.ui.view">
        <field name="name">tradeline.eta.job.form.vat.exception</field>
        <field name="model">tradeline.eta.job</field>
        <field name="inherit_id" ref="eta_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_send_now']" position="after">
                <button name="action_send_without_vat" type="object" string="Send without VAT…"
                    groups="tradeline_eta_reliability.group_eta_workspace" invisible="state in ('valid','accepted')"/>
            </xpath>
            <xpath expr="//field[@name='staff_state']" position="after">
                <field name="vat_review_state"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_disable_native_eta" model="ir.ui.view">
        <field name="name">account.move.form.eta.ahmed.only</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_eg_edi_eta.view_move_form_inherit"/>
        <field name="priority">1100</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post_sign_invoices']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='page_eta_e_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
