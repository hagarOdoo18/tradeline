<odoo>
    <data noupdate="1">
        <record id="group_eta_workspace" model="res.groups">
            <field name="name">ETA Status — central accounting</field>
            <field name="comment">Access to the ETA recovery workspace. This group grants no accounting data or posting permissions.</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
    <record id="eta_job_company_rule" model="ir.rule">
        <field name="name">ETA jobs: allowed companies</field>
        <field name="model_id" ref="model_tradeline_eta_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
