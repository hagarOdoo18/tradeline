<templates xml:space="preserve">
    <t t-name="tradeline_eta_reliability.ConnectionHealth">
        <div class="border-bottom bg-light px-3 py-2" aria-live="polite">
            <form class="d-flex flex-wrap align-items-center gap-2 mb-2" t-on-submit.prevent="findInvoice">
                <label class="fw-bold" for="eta_find_any_invoice">Find any invoice</label>
                <input id="eta_find_any_invoice" type="search" class="form-control form-control-sm flex-grow-1"
                    style="min-width:220px;max-width:540px" placeholder="Invoice number, branch reference, or paste its link"
                    t-model="state.query"/>
                <button type="submit" class="btn btn-sm btn-primary" t-att-disabled="state.finding || !state.query.trim()">Find invoice</button>
                <span class="small text-muted">Searches all dates and statuses.</span>
            </form>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <strong>ETA workspace</strong>
                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.open('today')">Today</button>
                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.open('all_invoices')">All invoices by day</button>
                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.open('backlog')">Backlog</button>
                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.open('sent_history')">Sent history</button>
                <button class="btn btn-sm btn-outline-success" t-on-click="() => this.open('approved_invoices')">Approved invoices</button>
                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.open('draft_invoices')">Drafts</button>
                <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.open('vat_issues')">VAT issues</button>
            </div>
            <div t-if="vatLane()" class="border rounded bg-white p-2 mb-2">
                <div class="d-flex flex-wrap gap-2 mb-2" aria-label="VAT correction work lists">
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.open('vat_issues')">All VAT issues</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="() => this.open('vat_unsent')">1. Not sent — add VAT</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" t-on-click="() => this.open('vat_approved')">2. Approved — credit and replace</button>
                    <button type="button" class="btn btn-sm btn-outline-warning" t-on-click="() => this.open('vat_in_progress')">Corrections already started</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.open('vat_rejected')">ETA invalid</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.open('vat_review')">Delivery / receipt review</button>
                </div>
                <div class="small" t-esc="vatInstructions()"/>
            </div>
            <div t-if="state.failed" class="text-warning">Connection readings could not be refreshed. Last displayed readings may be stale.</div>
            <div t-else="" t-foreach="state.rows" t-as="row" t-key="row.company_id" class="d-flex flex-wrap gap-3 align-items-center small mb-1">
                <strong t-esc="row.company"/>
                <span t-att-class="'badge '+color(row.state)" t-esc="label(row.state)"/>
                <span>Checked: <t t-esc="checked(row.checked_at)"/></span>
                <span>Connection response: <t t-esc="row.checked_at ? duration(row.response_seconds) : '—'"/></span>
                <span>Average send response: <t t-esc="duration(row.send_seconds)"/> (<t t-esc="row.send_count"/> samples)</span>
                <span>Average observed approval: <t t-esc="duration(row.approval_seconds)"/> (<t t-esc="row.approval_count"/> samples)</span>
            </div>
            <div class="text-muted small">Today includes invoices dated or created today, and older invoices sent or attempted today (Cairo time). All invoices groups by invoice day. Search by invoice number above. Connection checked every minute; display refreshes every 30 seconds. Averages use the last hour; approval delay includes status-check intervals.</div>
        </div>
    </t>
    <t t-name="tradeline_eta_reliability.WorkspaceList" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//div[@t-ref='root']" position="attributes"><attribute name="class">o_eta_workspace</attribute></xpath>
        <xpath expr="//SearchBar" position="attributes"><attribute name="autofocus">false</attribute></xpath>
        <xpath expr="//t[@t-component='props.Renderer']" position="before"><EtaConnectionHealth context="props.context"/></xpath>
    </t>
    <t t-name="tradeline_eta_reliability.WorkspaceFilterBar" t-inherit="web.SearchBar" t-inherit-mode="primary">
        <xpath expr="//t[@t-call='web.SearchBar.Input']" position="attributes">
            <attribute name="t-call">tradeline_eta_reliability.WorkspaceFilterInput</attribute>
        </xpath>
    </t>
    <t t-name="tradeline_eta_reliability.WorkspaceFilterInput" t-inherit="web.SearchBar.Input" t-inherit-mode="primary">
        <xpath expr="//input" position="attributes">
            <attribute name="placeholder">Filter this view (optional)…</attribute>
            <attribute name="aria-label">Filter this view only</attribute>
        </xpath>
    </t>
</templates>
