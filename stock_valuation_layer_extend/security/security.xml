<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_stock_valuation_quantity_correction" model="res.groups">
        <field name="name">Neutralize Erroneous Valuation Quantity</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager')), (4, ref('account.group_account_manager'))]"/>
    </record>
    <record id="group_count_cost_adjustment" model="res.groups">
        <field name="name">Count Stock and Set Cost</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_inventory_cost_approver" model="res.groups">
        <field name="name">Inventory Cost Approver</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock_valuation_layer_extend.group_count_cost_adjustment'))]"/>
    </record>
    <record id="rule_stock_count_cost_log_company" model="ir.rule">
        <field name="name">Controlled Stock Adjustments: active companies</field>
        <field name="model_id" ref="model_stock_count_cost_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_inventory_integrity_issue_company" model="ir.rule">
        <field name="name">Inventory Issues: active companies</field>
        <field name="model_id" ref="model_stock_inventory_integrity_issue"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_valuation_report_company" model="ir.rule">
        <field name="name">Valuation by Product: active companies</field>
        <field name="model_id" ref="model_stock_valuation_layer_report"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_valuation_candidate_company" model="ir.rule">
        <field name="name">Valuation Correction Candidates: active companies</field>
        <field name="model_id" ref="model_stock_valuation_quantity_correction_candidate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
