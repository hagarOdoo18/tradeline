<odoo>
    <record id="view_valuation_reconciliation_wizard" model="ir.ui.view">
        <field name="name">stock.valuation.reconciliation.wizard.form</field>
        <field name="model">stock.valuation.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="Reconcile Valuation to Verified Stock">
                <sheet>
                    <field name="state" widget="statusbar"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="alert alert-info" role="status">Update valuation to the recorded stock across all company locations. Physical stock stays unchanged. Locations and serials are selected automatically. Keep the current total value, or enter one unit cost for all stock of this product.</div>
                    <group>
                        <field name="company_id"/><field name="product_id"/><field name="lot_id" invisible="1"/>
                        <field name="physical_quantity" string="Recorded Physical Quantity / Target"/>
                        <field name="valuation_quantity" string="Valuation Quantity Before"/>
                        <field name="valuation_value" string="Valuation Value Before"/>
                        <field name="correction_quantity" string="Valuation Quantity Change"/>
                        <field name="value_policy" readonly="state != 'draft'"/>
                        <field name="target_unit_cost" invisible="value_policy != 'cost' or physical_quantity == 0" readonly="state != 'draft'"/>
                        <field name="confirmed" invisible="1"/>
                    </group>
                    <div class="alert alert-warning" role="status">Unit cost is the cost of ONE unit, not the total. Setting a cost revalues all recorded stock of this product, including every valued serial. Zero cost is allowed for approved zero-value stock. Value changes post a balanced journal entry using the automatic counterpart account. Historical delivery costs are not rewritten.</div>
                    <group string="Optional reference and accounting settings">
                        <field name="source" readonly="state != 'draft'"/>
                        <field name="reason" readonly="state != 'draft'"/>
                        <field name="counterpart_account_id" placeholder="Selected automatically at preview" domain="[('company_ids', 'in', [company_id]), ('deprecated', '=', False), ('account_type', 'not in', ['asset_receivable', 'liability_payable', 'off_balance'])]" readonly="state != 'draft'"/>
                    </group>
                    <group string="Preview / Posted correction" invisible="state == 'draft'">
                        <field name="pending_negative_quantity" string="Pending Negative Remaining Quantity to Close"/>
                        <div class="alert alert-info" role="status">This repair also rebases AVCO remaining quantities and values to the verified balance. Previous technical layer balances are retained for audit. Future receipts will not settle the closed phantom negative stock again.</div>
                        <field name="correction_value" string="Valuation Value / Journal Change"/>
                        <field name="resulting_value" string="Resulting Valuation Value"/>
                        <field name="resulting_cost" string="Resulting Cost per Unit"/>
                        <field name="correction_layer_id" invisible="state != 'done'"/>
                    </group>
                    <field name="detail_ids" invisible="state == 'draft' or not detail_ids">
                        <list create="0" edit="0" delete="0" open_form_view="0">
                            <field name="lot_id" string="Automatically selected serial / lot"/>
                            <field name="physical_quantity"/><field name="valuation_quantity"/>
                            <field name="correction_quantity"/><field name="correction_value"/>
                            <field name="resulting_value"/><field name="resulting_cost"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_edit" type="object" string="Edit" invisible="state != 'preview'"/>
                    <button name="action_apply" type="object" string="Reconcile Valuation Only" class="btn-primary" invisible="state != 'preview'"
                            confirm="Post the previewed valuation correction and any journal entry? Physical stock will stay unchanged."/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_valuation_reconciliation_history" model="ir.ui.view">
        <field name="name">stock.valuation.reconciliation.history</field>
        <field name="model">stock.valuation.layer</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/><field name="company_id"/><field name="product_id"/><field name="lot_id"/>
                <field name="reconciliation_user_id"/><field name="reconciliation_evidence"/>
                <field name="reconciliation_policy"/><field name="reconciliation_physical_quantity"/>
                <field name="reconciliation_previous_quantity"/><field name="reconciliation_previous_value"/>
                <field name="quantity"/><field name="value"/><field name="account_move_id"/><field name="description"/>
            </list>
        </field>
    </record>
    <record id="action_valuation_reconciliation_history" model="ir.actions.act_window">
        <field name="name">Valuation Reconciliation History</field>
        <field name="res_model">stock.valuation.layer</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_valuation_reconciliation_history"/>
        <field name="domain">[('is_valuation_reconciliation', '=', True)]</field>
    </record>
    <menuitem id="menu_valuation_reconciliation_history" name="Valuation Reconciliation History"
              parent="stock.menu_stock_inventory_control" action="action_valuation_reconciliation_history"
              groups="stock_valuation_layer_extend.group_stock_valuation_quantity_correction" sequence="57"/>
</odoo>
