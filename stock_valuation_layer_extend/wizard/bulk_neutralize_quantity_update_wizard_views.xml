<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_valuation_layer_bulk_neutralize_wizard_form" model="ir.ui.view">
        <field name="name">stock.valuation.layer.bulk.neutralize.wizard.form</field>
        <field name="model">stock.valuation.layer.bulk.neutralize.wizard</field>
        <field name="arch" type="xml">
            <form string="Neutralize Selected Valuation Errors">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Every selected row will create an auditable valuation and accounting correction. Physical stock will not change. The entire batch rolls back if any row fails validation.
                    </div>
                    <group>
                        <group>
                            <field name="candidate_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="total_correction_qty"/>
                            <field name="total_correction_value"/>
                        </group>
                    </group>
                    <field name="source_svl_ids" nolabel="1" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="product_id"/>
                            <field name="item_code"/>
                            <field name="lot_id"/>
                            <field name="reference"/>
                            <field name="quantity"/>
                            <field name="value"/>
                        </list>
                    </field>
                    <group>
                        <field name="reason" placeholder="Explain why this reviewed batch is being corrected."/>
                        <field name="confirmation"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Neutralize Selected" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bulk_neutralize_quantity_updates" model="ir.actions.act_window">
        <field name="name">Neutralize Selected Candidates</field>
        <field name="res_model">stock.valuation.layer.bulk.neutralize.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock_valuation_layer_bulk_neutralize_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_stock_valuation_quantity_correction_candidate"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('stock_valuation_layer_extend.group_stock_valuation_quantity_correction'))]"/>
    </record>
</odoo>
