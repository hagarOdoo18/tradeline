<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_preorder_confirmation" model="ir.actions.report">
        <field name="name">Pre-order Confirmation</field>
        <field name="model">sale.preorder</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">preorder_management.report_preorder_confirmation</field>
        <field name="report_file">preorder_management.report_preorder_confirmation</field>
        <field name="print_report_name">'Pre-order Confirmation - %s' % (object.name)</field>
    </record>

    <template id="report_preorder_confirmation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="preorder_management.report_preorder_confirmation_document" t-lang="o.customer_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_preorder_confirmation_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.customer_id.lang)"/>
            <div class="page">
                <div class="row mb-4">
                    <div class="col-6 offset-6">
                        <div t-field="o.customer_id"
                             t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>
                        <p t-if="o.customer_id.vat" class="mb-0">
                            <strong>Tax ID:</strong> <span t-field="o.customer_id.vat"/>
                        </p>
                    </div>
                </div>

                <h2 class="mb-3">Pre-order Confirmation # <span t-field="o.name"/></h2>

                <div class="row mb-4">
                    <div class="col-3">
                        <strong>Pre-order Date</strong><br/>
                        <span t-field="o.preorder_date" t-options="{'widget': 'date'}"/>
                    </div>
                    <div class="col-3">
                        <strong>Salesperson</strong><br/>
                        <span t-field="o.sales_rep_id"/>
                    </div>
                    <div class="col-3">
                        <strong>Branch</strong><br/>
                        <span t-field="o.branch_id"/>
                    </div>
                    <div class="col-3">
                        <strong>Reservation Status</strong><br/>
                        <strong t-if="o.allocation_id" class="text-success">Reserved</strong>
                        <span t-else="">Not Reserved</span>
                    </div>
                </div>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Taxes</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong>Reserved Device</strong><br/>
                                <span t-field="o.product_id"/>
                            </td>
                            <td class="text-end"><span t-out="'%.2f Units' % o.requested_qty"/></td>
                            <td class="text-end">
                                <span t-field="o.price_unit"
                                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            <td class="text-end"><span t-out="'%.2f' % o.discount"/>%</td>
                            <td class="text-end"><span t-out="o.get_report_tax_names()"/></td>
                            <td class="text-end">
                                <span t-field="o.amount_untaxed"
                                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="row justify-content-end mb-4">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr>
                                <td>Untaxed Amount</td>
                                <td class="text-end">
                                    <span t-field="o.amount_untaxed"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Taxes</td>
                                <td class="text-end">
                                    <span t-field="o.amount_tax"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                            <tr class="border-top">
                                <td><strong>Total</strong></td>
                                <td class="text-end">
                                    <strong t-field="o.deposit_amount"
                                            t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <t t-set="payments" t-value="o.get_report_payments()"/>
                <div t-if="payments">
                    <h3>Payments</h3>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Payment</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="payments" t-as="payment">
                                <td><span t-field="payment.journal_id"/></td>
                                <td><span t-field="payment.date"/></td>
                                <td class="text-end">
                                    <span t-out="o.get_report_payment_amount(payment)"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="border-top">
                                <th colspan="2" class="text-end">Total Paid</th>
                                <th class="text-end">
                                    <span t-out="o.get_report_payment_total()"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mt-4" t-if="o.product_id.product_notes" style="font-size: 8px; text-align: right;">
                    <span t-out="o.product_id.product_notes" dir="rtl"/>
                </div>
            </div>
        </t>
    </template>
</odoo>
