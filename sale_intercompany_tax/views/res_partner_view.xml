<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_intercompany" model="ir.ui.view">
        <field name="name">res.partner.form.intercompany.tax</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Inter-company Tax" name="intercompany_tax">
                    <group>
                        <group string="Inter-company Settings">
                            <field name="is_intercompany_customer"/>
                            <field name="is_auto_intercompany"
                                   invisible="not is_auto_intercompany"
                                   readonly="1"/>
                            <field name="intercompany_price_include"
                                   invisible="not is_intercompany_customer and not is_auto_intercompany"/>
                        </group>
                    </group>
                    <group string="Taxes Applied on Sale Order Lines"
                           invisible="not is_intercompany_customer and not is_auto_intercompany">
                        <field name="intercompany_tax_ids"
                               widget="many2many_tags"
                               nolabel="1"
                               colspan="2"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
