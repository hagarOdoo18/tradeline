<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Pricelist Import Wizard — Form View
         ================================================================ -->
    <record id="view_pricelist_import_wizard_form" model="ir.ui.view">
        <field name="name">pricelist.import.wizard.form</field>
        <field name="model">pricelist.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Pricelist Items">

                <!-- ── HEADER ─────────────────────────────────────────── -->
                <header>
                    <button name="action_preview"
                            string="Preview"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            icon="fa-eye"/>

                    <button name="action_import"
                            string="Import"
                            type="object"
                            class="btn-primary"
                            confirm="Are you sure you want to import all importable rows?"
                            invisible="state != 'preview'"
                            icon="fa-upload"/>

                    <button name="action_reset"
                            string="Reset"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('preview', 'done')"
                            icon="fa-refresh"/>

                    <button name="action_close"
                            string="Close"
                            type="object"
                            class="btn-secondary"
                            icon="fa-times"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,preview,done"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="pricelist_id" readonly="1"
                                   options="{'no_open': True}"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Pricelist Info">
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Validity">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="overwrite_existing"/>
                        </group>
                    </group>

                    <!-- ── RULE SETTINGS ──────────────────────────────── -->
                    <group string="Rule Settings">
                        <group>
                            <field name="applied_on"
                                   widget="radio"
                                   options="{'horizontal': true}"
                                   readonly="state != 'draft'"/>
                            <field name="compute_price"
                                   widget="radio"
                                   options="{'horizontal': true}"
                                   readonly="state != 'draft'"/>
                            <field name="formula_base"
                                   invisible="compute_price != 'formula'"
                                   required="compute_price == 'formula'"
                                   readonly="state != 'draft'"/>
                            <field name="base_pricelist_id"
                                   invisible="compute_price != 'formula' or formula_base != 'pricelist'"
                                   required="compute_price == 'formula' and formula_base == 'pricelist'"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="expected_columns"
                                   string="Sheet must contain"
                                   readonly="1"
                                   nolabel="0"/>
                        </group>
                    </group>

                    <!-- ── FILE UPLOAD (draft only) ───────────────────── -->
                    <group string="Import File" invisible="state != 'draft'">
                        <field name="import_file"
                               widget="binary"
                               filename="import_file_name"
                               string="Spreadsheet (.xlsx / .xls / .csv)"/>
                        <field name="import_file_name" invisible="1"/>
                    </group>

                    <!-- ── SUMMARY ────────────────────────────────────── -->
                    <div class="alert alert-info" role="alert"
                         invisible="not import_summary">
                        <field name="import_summary" readonly="1" nolabel="1"/>
                    </div>

                    <!-- ── PREVIEW TABLE ──────────────────────────────── -->
                    <notebook invisible="state == 'draft'">
                        <page string="Preview Lines" name="preview_lines">
                            <field name="preview_line_ids" readonly="1">
                                <list decoration-danger="status == 'error'"
                                      decoration-warning="status == 'warning'"
                                      decoration-success="status == 'ok'">
                                    <field name="row_number" string="Row"/>
                                    <field name="item_code"/>
                                    <field name="product_name"/>
                                    <field name="product_tmpl_id" optional="hide"
                                           column_invisible="parent.applied_on not in ('1_product', '0_product_variant')"/>
                                    <field name="product_id" optional="show"
                                           column_invisible="parent.applied_on != '0_product_variant'"/>
                                    <field name="categ_id" optional="show"
                                           column_invisible="parent.applied_on != '2_product_category'"/>
                                    <field name="min_quantity"/>
                                    <field name="fixed_price"
                                           column_invisible="parent.compute_price != 'fixed'"/>
                                    <field name="percent_price"
                                           column_invisible="parent.compute_price != 'percentage'"/>
                                    <field name="price_discount"
                                           column_invisible="parent.compute_price != 'formula'"/>
                                    <field name="price_surcharge"
                                           column_invisible="parent.compute_price != 'formula'"/>
                                    <field name="price_round" optional="hide"
                                           column_invisible="parent.compute_price != 'formula'"/>
                                    <field name="price_min_margin" optional="hide"
                                           column_invisible="parent.compute_price != 'formula'"/>
                                    <field name="price_max_margin" optional="hide"
                                           column_invisible="parent.compute_price != 'formula'"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'ok'"
                                           decoration-warning="status == 'warning'"
                                           decoration-danger="status == 'error'"/>
                                    <field name="error_message" string="Message"
                                           optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Action to open the wizard
         ================================================================ -->
    <record id="action_pricelist_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Items from File</field>
        <field name="res_model">pricelist.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pricelist_import_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'active_id': active_id}</field>
    </record>

</odoo>
