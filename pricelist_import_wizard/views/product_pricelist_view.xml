<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the standard pricelist form: Import Items + Clear Items -->
    <record id="view_product_pricelist_form_import_btn" model="ir.ui.view">
        <field name="name">product.pricelist.form.import.button</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="%(pricelist_import_wizard.action_pricelist_import_wizard)d"
                        string="Import Items"
                        type="action"
                        class="btn-primary"
                        icon="fa-upload"/>

                <button name="action_clear_items"
                        string="Clear Items"
                        type="object"
                        class="btn-secondary"
                        icon="fa-trash"
                        invisible="pricelist_item_count == 0"
                        confirm="This permanently deletes ALL price rules in this pricelist and cannot be undone. Continue?"/>

                <!-- Drives the Clear Items button's visibility -->
                <field name="pricelist_item_count" invisible="1"/>
            </xpath>

        </field>
    </record>
</odoo>
