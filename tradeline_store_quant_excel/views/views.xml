<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="wizard_store_quant_report_view">
            <field name="name">Store Product Quantity Excel</field>
            <field name="model">store.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Store Product Quantity Excel">
                    <group>
                        <field name="gentextfile" filename="filename" readonly="1"
                               invisible="not gentextfile"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_generate_warranty_report"
                                string="Store Product Quantity Report"
                                type="object" class="oe_highlight"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="wizard_store_quant_report_view_action" model="ir.actions.act_window">
            <field name="name">Store Product Quantity Excel</field>
            <field name="res_model">store.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="wizard_store_quant_report_view"/>
            <field name="target">new</field>
        </record>

        <menuitem id="wizard_store_quant_report_view_menu_action"
                  name="Store Product Quantity Excel"
                  parent="stock.menu_warehouse_report"
                  action="wizard_store_quant_report_view_action"
                  sequence="15"
                  groups="group_store_quant"/>
    </data>
</odoo>
