<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_verify_code_import_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.verify.code.import.wizard.form</field>
        <field name="model">stock.lot.verify.code.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Verify Codes">
                <div class="alert alert-info" role="alert">
                    Upload an Excel (.xlsx) file with two columns: <b>serial</b> and <b>code</b>.
                    The first row is treated as a header. Each code is written to the matching lot/serial.
                </div>
                <group>
                    <field name="file" filename="filename" widget="binary"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button string="Import" name="action_import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_lot_verify_code_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Verify Codes</field>
        <field name="res_model">stock.lot.verify.code.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_lot_verify_code_import_wizard"
              name="Import Verify Codes"
              parent="stock.menu_stock_inventory_control"
              action="action_stock_lot_verify_code_import_wizard"
              sequence="90"/>
</odoo>
