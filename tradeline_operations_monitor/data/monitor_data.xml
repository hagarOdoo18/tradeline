<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="monitor_default" model="tradeline.operations.monitor">
        <field name="name">Tradeline Operations</field>
        <field name="active" eval="False"/>
    </record>
    <record id="cron_check_operations" model="ir.cron">
        <field name="name">Operations: Check Business Health</field>
        <field name="model_id" ref="model_tradeline_operations_monitor"/>
        <field name="code">model._cron_check()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="priority">1</field>
    </record>
    <record id="cron_send_operations_alerts" model="ir.cron">
        <field name="name">Operations: Deliver Alert Emails</field>
        <field name="model_id" ref="model_tradeline_operations_monitor"/>
        <field name="code">model._cron_send_alerts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="priority">2</field>
    </record>
</odoo>
