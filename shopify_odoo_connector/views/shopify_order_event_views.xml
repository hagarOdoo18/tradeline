<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shopify_order_event_view_list" model="ir.ui.view">
        <field name="name">shopify.order.event.list</field>
        <field name="model">shopify.order.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'blocked'"
                  decoration-success="state in ('done', 'duplicate')">
                <field name="received_at"/>
                <field name="shopify_order_name"/>
                <field name="shopify_order_id"/>
                <field name="instance_id"/>
                <field name="warehouse_id"/>
                <field name="state"/>
                <field name="reservation_state"/>
                <field name="attempts"/>
                <field name="order_id"/>
            </list>
        </field>
    </record>
    <record id="shopify_order_event_view_form" model="ir.ui.view">
        <field name="name">shopify.order.event.form</field>
        <field name="model">shopify.order.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="oe_highlight"
                            invisible="state not in ('blocked', 'failed')"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="topic"/>
                            <field name="instance_id"/>
                            <field name="received_at"/>
                            <field name="processed_at"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="reservation_state"/>
                            <field name="attempts"/>
                            <field name="shopify_order_id"/>
                            <field name="shopify_order_name"/>
                            <field name="order_id"/>
                            <field name="warehouse_id"/>
                            <field name="warehouse_source"/>
                        </group>
                    </group>
                    <group string="Processing Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="Payload (automatically removed after 30 days)">
                        <field name="payload" widget="json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="shopify_order_event_view_search" model="ir.ui.view">
        <field name="name">shopify.order.event.search</field>
        <field name="model">shopify.order.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="shopify_order_name"/>
                <field name="shopify_order_id"/>
                <field name="event_id"/>
                <field name="instance_id"/>
                <filter name="needs_attention" string="Needs Attention"
                        domain="[('state', 'in', ('blocked', 'failed'))]"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>
    <record id="shopify_order_event_action" model="ir.actions.act_window">
        <field name="name">Order API Events</field>
        <field name="res_model">shopify.order.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="shopify_order_event_view_search"/>
    </record>
    <menuitem id="shopify_order_event_menu" name="Order API Events"
              parent="shopify_configuration_menu_root"
              action="shopify_order_event_action" sequence="90"
              groups="shopify_odoo_connector.group_shopify_manager"/>
</odoo>
