<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    list view for shopify.sync-->
    <record id="shopify_sync_view_list" model="ir.ui.view">
        <field name="name">shopify.sync.view.list</field>
        <field name="model">shopify.sync</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="1">
                <field name="instance_id"/>
                <field name="shopify_order_name"/>
                <field name="shopify_order_number"/>
                <field name="customer_id"/>
                <field name="order_id"/>
                <field name="product_id" optional="hide"/>
                <field name="product_prod_id" optional="hide"/>
                <field name="payment_status"/>
                <field name="fulfillment_status"/>
                <field name="order_status"/>
                <field name="synced_order" widget="boolean_toggle"/>
                <field name="last_order_id" optional="hide"/>
            </list>
        </field>
    </record>
    <!--    form view for shopify.sync-->
    <record id="shopify_sync_view_form" model="ir.ui.view">
        <field name="name">shopify.sync.view.form</field>
        <field name="model">shopify.sync</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="shopify_order_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Shopify References">
                            <field name="instance_id" readonly="1"/>
                            <field name="shopify_order_ref" readonly="1"/>
                            <field name="shopify_order_number" readonly="1"/>
                            <field name="shopify_product" readonly="1"/>
                            <field name="shopify_variant_id" readonly="1"/>
                            <field name="shopify_customer_ref" readonly="1"/>
                            <field name="last_order_id" readonly="1"/>
                        </group>
                        <group string="Odoo References">
                            <field name="customer_id" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_prod_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Status">
                        <group>
                            <field name="synced_order" readonly="1"/>
                            <field name="order_status" readonly="1"/>
                        </group>
                        <group>
                            <field name="payment_status" readonly="1"/>
                            <field name="fulfillment_status" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--    search view for shopify.sync-->
    <record id="shopify_sync_view_search" model="ir.ui.view">
        <field name="name">shopify.sync.view.search</field>
        <field name="model">shopify.sync</field>
        <field name="arch" type="xml">
            <search string="Shopify Sync">
                <field name="shopify_order_name"/>
                <field name="shopify_order_number"/>
                <field name="instance_id"/>
                <field name="customer_id"/>
                <field name="order_id"/>
                <separator/>
                <filter string="Synced Orders" name="synced"
                        domain="[('synced_order', '=', True)]"/>
                <filter string="Not Synced" name="not_synced"
                        domain="[('synced_order', '=', False)]"/>
                <separator/>
                <filter string="Paid" name="paid"
                        domain="[('payment_status', '=', 'paid')]"/>
                <filter string="Unpaid" name="unpaid"
                        domain="[('payment_status', '=', 'unpaid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Instance" name="group_instance"
                            context="{'group_by': 'instance_id'}"/>
                    <filter string="Payment Status" name="group_payment_status"
                            context="{'group_by': 'payment_status'}"/>
                    <filter string="Fulfillment Status"
                            name="group_fulfillment_status"
                            context="{'group_by': 'fulfillment_status'}"/>
                    <filter string="Order Status" name="group_order_status"
                            context="{'group_by': 'order_status'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--    action for shopify.sync-->
    <record id="shopify_sync_action" model="ir.actions.act_window">
        <field name="name">Shopify Sync</field>
        <field name="res_model">shopify.sync</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="shopify_sync_view_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No Shopify sync records found
            </p>
        </field>
    </record>
    <!--    menu for shopify.sync-->
    <menuitem id="shopify_sync_menu" name="Sync Logs"
              parent="shopify_odoo_connector.shopify_configuration_menu_root"
              action="shopify_sync_action"
              sequence="60"/>
</odoo>
