<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_retry_shopify_order_events" model="ir.cron">
        <field name="name">Shopify: Retry Order Events</field>
        <field name="model_id" ref="model_shopify_order_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_order_events()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_redact_shopify_order_payloads" model="ir.cron">
        <field name="name">Shopify: Redact Processed Order Payloads</field>
        <field name="model_id" ref="model_shopify_order_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_redact_old_payloads()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
